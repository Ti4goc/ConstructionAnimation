using Game;
using Game.Buildings;
using Game.Common;
using Game.Objects;
using Game.Prefabs;
using Game.Rendering;
using System;
using Unity.Collections;
using Unity.Entities;
using Unity.Mathematics;
using UnityEngine;

namespace ConstructionAnimation.Systems
{
    public partial class ConstructionDetectionSystem : GameSystemBase
    {
        private EntityQuery m_BuildingQuery;

        private Entity m_TrackedBuilding = Entity.Null;
        private Entity m_VisualProxy = Entity.Null;

        private Entity m_PendingProxyDestroy = Entity.Null;
        private int m_PendingProxyDestroyFrames = 0;

        private const int ProxyDestroyDelayFrames = 4;

        private float m_BuildingHeight = 20f;

        private float3 m_BuildingSize =
            new float3(
                20f,
                20f,
                20f
            );

        private float3 m_GeometryPivot =
            float3.zero;

        private byte m_LastProgress = 255;

        // ============================================================
        // V1.33.4 SCAFFOLD
        // ============================================================

        private GameObject m_ScaffoldRoot;
        private GameObject m_ScaffoldVisualRoot;

        private Material m_ScaffoldMetalMaterial;
        private Material m_ScaffoldDeckMaterial;

        private float m_ScaffoldBottomY;
        private float m_ScaffoldHeight;

        private const float ScaffoldMargin = 1.2f;

        private const float ScaffoldModuleWidth = 3.0f;
        private const float ScaffoldModuleHeight = 3.0f;

        private const float ScaffoldBeamThickness = 0.12f;

        // Slightly above terrain to avoid z-fighting.
        private const float ScaffoldGroundOffset = 0.05f;

        // Full height reached at 80% construction.
        private const float ScaffoldRiseEnd = 0.80f;

        // One scaffold level visible immediately.
        private const float ScaffoldMinimumVisibleHeight = 3.0f;

        protected override void OnCreate()
        {
            base.OnCreate();

            m_BuildingQuery =
                GetEntityQuery(
                    ComponentType.ReadOnly<UnderConstruction>(),
                    ComponentType.ReadOnly<Building>(),
                    ComponentType.ReadOnly<PrefabRef>(),
                    ComponentType.ReadOnly<Game.Objects.Transform>()
                );

            ModLog.Info(
                "ConstructionAnimation V1.33.4 ground-anchored scaffold created."
            );
        }

        protected override void OnUpdate()
        {
            ProcessPendingProxyDestroy();

            bool trackedBuildingValid =
                m_TrackedBuilding != Entity.Null &&
                EntityManager.Exists(m_TrackedBuilding) &&
                EntityManager.HasComponent<UnderConstruction>(
                    m_TrackedBuilding
                );

            if (!trackedBuildingValid)
            {
                CleanupTrackedConstruction();

                FindBuilding();

                if (
                    m_TrackedBuilding ==
                    Entity.Null
                )
                {
                    return;
                }

                CreateNativeProxy(
                    m_TrackedBuilding
                );

                CreateScaffoldCage();
            }

            if (
                m_VisualProxy == Entity.Null ||
                !EntityManager.Exists(
                    m_VisualProxy
                )
            )
            {
                return;
            }

            UpdateConstructionAnimation();
        }

        // ============================================================
        // BUILDING DETECTION
        // ============================================================

        private void FindBuilding()
        {
            m_TrackedBuilding =
                Entity.Null;

            m_LastProgress =
                255;

            if (
                m_BuildingQuery
                    .IsEmptyIgnoreFilter
            )
            {
                return;
            }

            using NativeArray<Entity> buildings =
                m_BuildingQuery
                    .ToEntityArray(
                        Allocator.Temp
                    );

            if (
                buildings.Length ==
                0
            )
            {
                return;
            }

            m_TrackedBuilding =
                buildings[0];

            PrefabRef prefabRef =
                EntityManager
                    .GetComponentData<PrefabRef>(
                        m_TrackedBuilding
                    );

            UnderConstruction construction =
                EntityManager
                    .GetComponentData<UnderConstruction>(
                        m_TrackedBuilding
                    );

            ModLog.Info(
                $"V1.33.4 tracking building " +
                $"{m_TrackedBuilding.Index}:" +
                $"{m_TrackedBuilding.Version}"
            );

            ModLog.Info(
                $"V1.33.4 source prefab = " +
                $"{prefabRef.m_Prefab.Index}:" +
                $"{prefabRef.m_Prefab.Version}"
            );

            ModLog.Info(
                $"V1.33.4 initial progress = " +
                $"{construction.m_Progress}%"
            );
        }

        // ============================================================
        // NATIVE BUILDING PROXY
        // ============================================================

        private void CreateNativeProxy(
            Entity source
        )
        {
            try
            {
                ScheduleNativeProxyDestroy();

                PrefabRef prefabRef =
                    EntityManager
                        .GetComponentData<PrefabRef>(
                            source
                        );

                Game.Objects.Transform transform =
                    EntityManager
                        .GetComponentData<Game.Objects.Transform>(
                            source
                        );

                ReadBuildingGeometry(
                    prefabRef.m_Prefab
                );

                EntityArchetype archetype =
                    EntityManager
                        .CreateArchetype(
                            typeof(PrefabRef),
                            typeof(Game.Objects.Transform),
                            typeof(Game.Objects.Object),
                            typeof(Game.Objects.ObjectGeometry),
                            typeof(Game.Objects.Static),
                            typeof(Created),
                            typeof(Updated),
                            typeof(Unity.Entities.Simulate)
                        );

                m_VisualProxy =
                    EntityManager
                        .CreateEntity(
                            archetype
                        );

                EntityManager.SetComponentData(
                    m_VisualProxy,
                    prefabRef
                );

                EntityManager.SetComponentData(
                    m_VisualProxy,
                    transform
                );

                CopyVisualComponent<CullingInfo>(
                    source
                );

                CopyVisualComponent<Game.Objects.Color>(
                    source
                );

                CopyVisualComponent<Game.Objects.Surface>(
                    source
                );

                CopyVisualComponent<PseudoRandomSeed>(
                    source
                );

                CopyMeshColorBuffer(
                    source
                );

                CopyCustomMeshColorBuffer(
                    source
                );

                if (
                    !EntityManager
                        .HasBuffer<MeshBatch>(
                            m_VisualProxy
                        )
                )
                {
                    EntityManager
                        .AddBuffer<MeshBatch>(
                            m_VisualProxy
                        );
                }

                ModLog.Info(
                    $"V1.33.4 native proxy = " +
                    $"{m_VisualProxy.Index}:" +
                    $"{m_VisualProxy.Version}"
                );

                ModLog.Info(
                    $"V1.33.4 building size = " +
                    $"{m_BuildingSize}"
                );

                ModLog.Info(
                    $"V1.33.4 geometry pivot = " +
                    $"{m_GeometryPivot}"
                );
            }
            catch (Exception ex)
            {
                ModLog.Error(
                    $"V1.33.4 CreateNativeProxy failed: {ex}"
                );

                ScheduleNativeProxyDestroy();
            }
        }

        private void ReadBuildingGeometry(
            Entity prefab
        )
        {
            m_BuildingHeight =
                20f;

            m_BuildingSize =
                new float3(
                    20f,
                    20f,
                    20f
                );

            m_GeometryPivot =
                float3.zero;

            try
            {
                if (
                    !EntityManager
                        .HasComponent<ObjectGeometryData>(
                            prefab
                        )
                )
                {
                    return;
                }

                ObjectGeometryData geometry =
                    EntityManager
                        .GetComponentData<ObjectGeometryData>(
                            prefab
                        );

                m_BuildingSize =
                    geometry.m_Size;

                m_GeometryPivot =
                    geometry.m_Pivot;

                if (
                    geometry.m_Size.y > 0.5f &&
                    geometry.m_Size.y < 1000f
                )
                {
                    m_BuildingHeight =
                        geometry.m_Size.y;
                }
            }
            catch (Exception ex)
            {
                ModLog.Info(
                    $"V1.33.4 geometry read failed: " +
                    $"{ex.GetType().Name}"
                );
            }
        }

        // ============================================================
        // MAIN ANIMATION
        // ============================================================

        private void UpdateConstructionAnimation()
        {
            if (
                m_TrackedBuilding == Entity.Null ||
                m_VisualProxy == Entity.Null
            )
            {
                return;
            }

            if (
                !EntityManager.Exists(
                    m_TrackedBuilding
                ) ||
                !EntityManager.Exists(
                    m_VisualProxy
                )
            )
            {
                return;
            }

            if (
                !EntityManager
                    .HasComponent<UnderConstruction>(
                        m_TrackedBuilding
                    )
            )
            {
                return;
            }

            Game.Objects.Transform sourceTransform =
                EntityManager
                    .GetComponentData<Game.Objects.Transform>(
                        m_TrackedBuilding
                    );

            UnderConstruction construction =
                EntityManager
                    .GetComponentData<UnderConstruction>(
                        m_TrackedBuilding
                    );

            float progress =
                math.saturate(
                    construction.m_Progress /
                    100f
                );

            UpdateBuildingProxy(
                sourceTransform,
                progress
            );

            UpdateScaffold(
                sourceTransform,
                progress
            );

            LogProgress(
                construction,
                progress
            );
        }

        // ============================================================
        // BUILDING RISE
        // ============================================================

        private void UpdateBuildingProxy(
            Game.Objects.Transform sourceTransform,
            float progress
        )
        {
            float hiddenDistance =
                m_BuildingHeight +
                0.5f;

            float verticalOffset =
                -hiddenDistance *
                (
                    1f -
                    progress
                );

            Game.Objects.Transform proxyTransform =
                sourceTransform;

            proxyTransform.m_Position.y +=
                verticalOffset;

            EntityManager.SetComponentData(
                m_VisualProxy,
                proxyTransform
            );

            MarkProxyUpdated();
        }

        private void MarkProxyUpdated()
        {
            if (
                m_VisualProxy == Entity.Null ||
                !EntityManager.Exists(
                    m_VisualProxy
                )
            )
            {
                return;
            }

            if (
                !EntityManager
                    .HasComponent<Updated>(
                        m_VisualProxy
                    )
            )
            {
                EntityManager
                    .AddComponent<Updated>(
                        m_VisualProxy
                    );
            }
        }

        // ============================================================
        // V1.33.4 SCAFFOLD ANIMATION
        //
        // Important:
        //
        // The scaffold is now anchored at terrain level.
        //
        // Geometry pivot of the building is NOT used for scaffold
        // vertical placement.
        //
        // 0 - 80%:
        // scaffold grows upward.
        //
        // 80 - 100%:
        // full scaffold descends underground.
        // ============================================================

        private void UpdateScaffold(
            Game.Objects.Transform sourceTransform,
            float progress
        )
        {
            if (
                m_ScaffoldRoot == null ||
                m_ScaffoldVisualRoot == null
            )
            {
                return;
            }

            float3 worldPosition =
                sourceTransform.m_Position;

            m_ScaffoldRoot.transform.position =
                new Vector3(
                    worldPosition.x,
                    worldPosition.y,
                    worldPosition.z
                );

            quaternion q =
                sourceTransform.m_Rotation;

            m_ScaffoldRoot.transform.rotation =
                new Quaternion(
                    q.value.x,
                    q.value.y,
                    q.value.z,
                    q.value.w
                );

            // --------------------------------------------------------
            // PHASE 1:
            // Anchored at terrain level and grows upward.
            // --------------------------------------------------------

            if (
                progress <=
                ScaffoldRiseEnd
            )
            {
                float growthProgress =
                    math.saturate(
                        progress /
                        ScaffoldRiseEnd
                    );

                float minimumScale =
                    math.saturate(
                        ScaffoldMinimumVisibleHeight /
                        math.max(
                            m_ScaffoldHeight,
                            0.1f
                        )
                    );

                float verticalScale =
                    math.lerp(
                        minimumScale,
                        1f,
                        growthProgress
                    );

                m_ScaffoldVisualRoot
                    .transform
                    .localPosition =
                    new Vector3(
                        0f,
                        m_ScaffoldBottomY,
                        0f
                    );

                m_ScaffoldVisualRoot
                    .transform
                    .localScale =
                    new Vector3(
                        1f,
                        verticalScale,
                        1f
                    );
            }

            // --------------------------------------------------------
            // PHASE 2:
            // Full scaffold descends.
            // --------------------------------------------------------

            else
            {
                float descendProgress =
                    math.saturate(
                        (
                            progress -
                            ScaffoldRiseEnd
                        ) /
                        (
                            1f -
                            ScaffoldRiseEnd
                        )
                    );

                float descendDistance =
                    m_ScaffoldHeight +
                    2f;

                float descendOffset =
                    -descendDistance *
                    descendProgress;

                m_ScaffoldVisualRoot
                    .transform
                    .localScale =
                    Vector3.one;

                m_ScaffoldVisualRoot
                    .transform
                    .localPosition =
                    new Vector3(
                        0f,
                        m_ScaffoldBottomY +
                        descendOffset,
                        0f
                    );
            }
        }

        // ============================================================
        // PROCEDURAL SCAFFOLD
        // ============================================================

        private void CreateScaffoldCage()
        {
            DestroyScaffold();

            try
            {
                CreateScaffoldMaterials();

                m_ScaffoldRoot =
                    new GameObject(
                        "ConstructionAnimation_V1_33_4_ScaffoldRoot"
                    );

                m_ScaffoldRoot.hideFlags =
                    HideFlags.DontSave;

                m_ScaffoldVisualRoot =
                    new GameObject(
                        "ConstructionAnimation_V1_33_4_ScaffoldVisual"
                    );

                m_ScaffoldVisualRoot.hideFlags =
                    HideFlags.DontSave;

                m_ScaffoldVisualRoot
                    .transform
                    .SetParent(
                        m_ScaffoldRoot.transform,
                        false
                    );

                float halfWidth =
                    m_BuildingSize.x *
                    0.5f +
                    ScaffoldMargin;

                float halfDepth =
                    m_BuildingSize.z *
                    0.5f +
                    ScaffoldMargin;

                // ====================================================
                // V1.33.4 FIX
                //
                // OLD:
                // m_ScaffoldBottomY = -m_GeometryPivot.y;
                //
                // That placed the first ~6.65 metres underground
                // on our test building.
                //
                // NEW:
                // ground-anchored scaffold.
                // ====================================================

                m_ScaffoldBottomY =
                    ScaffoldGroundOffset;

                m_ScaffoldHeight =
                    m_BuildingHeight +
                    1.0f;

                m_ScaffoldVisualRoot
                    .transform
                    .localPosition =
                    new Vector3(
                        0f,
                        m_ScaffoldBottomY,
                        0f
                    );

                m_ScaffoldVisualRoot
                    .transform
                    .localScale =
                    Vector3.one;

                float bottomY =
                    0f;

                float topY =
                    m_ScaffoldHeight;

                CreateFacadeGridX(
                    -halfDepth,
                    halfWidth,
                    bottomY,
                    topY
                );

                CreateFacadeGridX(
                    halfDepth,
                    halfWidth,
                    bottomY,
                    topY
                );

                CreateSideFace(
                    -halfWidth,
                    halfDepth,
                    bottomY,
                    topY
                );

                CreateSideFace(
                    halfWidth,
                    halfDepth,
                    bottomY,
                    topY
                );

                CreateTopStructure(
                    halfWidth,
                    halfDepth,
                    topY
                );

                CreateTopDeck(
                    halfWidth,
                    halfDepth,
                    topY +
                    0.10f
                );

                ModLog.Info(
                    $"V1.33.4 scaffold created: " +
                    $"width={halfWidth * 2f:0.00}m " +
                    $"depth={halfDepth * 2f:0.00}m " +
                    $"height={m_ScaffoldHeight:0.00}m " +
                    $"groundY={m_ScaffoldBottomY:0.00}m"
                );

                ModLog.Info(
                    $"V1.33.4 ignored geometry pivot for scaffold Y: " +
                    $"pivotY={m_GeometryPivot.y:0.00}m"
                );
            }
            catch (Exception ex)
            {
                ModLog.Error(
                    $"V1.33.4 CreateScaffoldCage failed: {ex}"
                );

                DestroyScaffold();
            }
        }

        // ============================================================
        // FRONT / BACK
        // ============================================================

        private void CreateFacadeGridX(
            float z,
            float halfWidth,
            float bottomY,
            float topY
        )
        {
            int horizontalModules =
                Math.Max(
                    1,
                    Mathf.CeilToInt(
                        (
                            halfWidth *
                            2f
                        ) /
                        ScaffoldModuleWidth
                    )
                );

            int verticalModules =
                Math.Max(
                    1,
                    Mathf.CeilToInt(
                        (
                            topY -
                            bottomY
                        ) /
                        ScaffoldModuleHeight
                    )
                );

            // --------------------------------------------------------
            // Vertical posts
            // --------------------------------------------------------

            for (
                int xIndex = 0;
                xIndex <= horizontalModules;
                xIndex++
            )
            {
                float x =
                    Mathf.Lerp(
                        -halfWidth,
                        halfWidth,
                        xIndex /
                        (float)horizontalModules
                    );

                CreateBeamBetween(
                    new Vector3(
                        x,
                        bottomY,
                        z
                    ),
                    new Vector3(
                        x,
                        topY,
                        z
                    ),
                    ScaffoldBeamThickness,
                    m_ScaffoldMetalMaterial
                );
            }

            // --------------------------------------------------------
            // Horizontal beams
            // --------------------------------------------------------

            for (
                int yIndex = 0;
                yIndex <= verticalModules;
                yIndex++
            )
            {
                float y =
                    Mathf.Lerp(
                        bottomY,
                        topY,
                        yIndex /
                        (float)verticalModules
                    );

                CreateBeamBetween(
                    new Vector3(
                        -halfWidth,
                        y,
                        z
                    ),
                    new Vector3(
                        halfWidth,
                        y,
                        z
                    ),
                    ScaffoldBeamThickness,
                    m_ScaffoldMetalMaterial
                );
            }

            // --------------------------------------------------------
            // X braces
            // --------------------------------------------------------

            for (
                int xIndex = 0;
                xIndex < horizontalModules;
                xIndex++
            )
            {
                float x0 =
                    Mathf.Lerp(
                        -halfWidth,
                        halfWidth,
                        xIndex /
                        (float)horizontalModules
                    );

                float x1 =
                    Mathf.Lerp(
                        -halfWidth,
                        halfWidth,
                        (
                            xIndex +
                            1
                        ) /
                        (float)horizontalModules
                    );

                for (
                    int yIndex = 0;
                    yIndex < verticalModules;
                    yIndex++
                )
                {
                    float y0 =
                        Mathf.Lerp(
                            bottomY,
                            topY,
                            yIndex /
                            (float)verticalModules
                        );

                    float y1 =
                        Mathf.Lerp(
                            bottomY,
                            topY,
                            (
                                yIndex +
                                1
                            ) /
                            (float)verticalModules
                        );

                    CreateBeamBetween(
                        new Vector3(
                            x0,
                            y0,
                            z
                        ),
                        new Vector3(
                            x1,
                            y1,
                            z
                        ),
                        ScaffoldBeamThickness *
                        0.70f,
                        m_ScaffoldMetalMaterial
                    );

                    CreateBeamBetween(
                        new Vector3(
                            x0,
                            y1,
                            z
                        ),
                        new Vector3(
                            x1,
                            y0,
                            z
                        ),
                        ScaffoldBeamThickness *
                        0.70f,
                        m_ScaffoldMetalMaterial
                    );
                }
            }
        }

        // ============================================================
        // LEFT / RIGHT
        // ============================================================

        private void CreateSideFace(
            float x,
            float halfDepth,
            float bottomY,
            float topY
        )
        {
            int horizontalModules =
                Math.Max(
                    1,
                    Mathf.CeilToInt(
                        (
                            halfDepth *
                            2f
                        ) /
                        ScaffoldModuleWidth
                    )
                );

            int verticalModules =
                Math.Max(
                    1,
                    Mathf.CeilToInt(
                        (
                            topY -
                            bottomY
                        ) /
                        ScaffoldModuleHeight
                    )
                );

            // --------------------------------------------------------
            // Vertical posts
            // --------------------------------------------------------

            for (
                int zIndex = 0;
                zIndex <= horizontalModules;
                zIndex++
            )
            {
                float z =
                    Mathf.Lerp(
                        -halfDepth,
                        halfDepth,
                        zIndex /
                        (float)horizontalModules
                    );

                CreateBeamBetween(
                    new Vector3(
                        x,
                        bottomY,
                        z
                    ),
                    new Vector3(
                        x,
                        topY,
                        z
                    ),
                    ScaffoldBeamThickness,
                    m_ScaffoldMetalMaterial
                );
            }

            // --------------------------------------------------------
            // Horizontal beams
            // --------------------------------------------------------

            for (
                int yIndex = 0;
                yIndex <= verticalModules;
                yIndex++
            )
            {
                float y =
                    Mathf.Lerp(
                        bottomY,
                        topY,
                        yIndex /
                        (float)verticalModules
                    );

                CreateBeamBetween(
                    new Vector3(
                        x,
                        y,
                        -halfDepth
                    ),
                    new Vector3(
                        x,
                        y,
                        halfDepth
                    ),
                    ScaffoldBeamThickness,
                    m_ScaffoldMetalMaterial
                );
            }

            // --------------------------------------------------------
            // X braces
            // --------------------------------------------------------

            for (
                int zIndex = 0;
                zIndex < horizontalModules;
                zIndex++
            )
            {
                float z0 =
                    Mathf.Lerp(
                        -halfDepth,
                        halfDepth,
                        zIndex /
                        (float)horizontalModules
                    );

                float z1 =
                    Mathf.Lerp(
                        -halfDepth,
                        halfDepth,
                        (
                            zIndex +
                            1
                        ) /
                        (float)horizontalModules
                    );

                for (
                    int yIndex = 0;
                    yIndex < verticalModules;
                    yIndex++
                )
                {
                    float y0 =
                        Mathf.Lerp(
                            bottomY,
                            topY,
                            yIndex /
                            (float)verticalModules
                        );

                    float y1 =
                        Mathf.Lerp(
                            bottomY,
                            topY,
                            (
                                yIndex +
                                1
                            ) /
                            (float)verticalModules
                        );

                    CreateBeamBetween(
                        new Vector3(
                            x,
                            y0,
                            z0
                        ),
                        new Vector3(
                            x,
                            y1,
                            z1
                        ),
                        ScaffoldBeamThickness *
                        0.70f,
                        m_ScaffoldMetalMaterial
                    );

                    CreateBeamBetween(
                        new Vector3(
                            x,
                            y1,
                            z0
                        ),
                        new Vector3(
                            x,
                            y0,
                            z1
                        ),
                        ScaffoldBeamThickness *
                        0.70f,
                        m_ScaffoldMetalMaterial
                    );
                }
            }
        }

        // ============================================================
        // TOP GRID
        // ============================================================

        private void CreateTopStructure(
            float halfWidth,
            float halfDepth,
            float y
        )
        {
            int xModules =
                Math.Max(
                    1,
                    Mathf.CeilToInt(
                        (
                            halfWidth *
                            2f
                        ) /
                        ScaffoldModuleWidth
                    )
                );

            int zModules =
                Math.Max(
                    1,
                    Mathf.CeilToInt(
                        (
                            halfDepth *
                            2f
                        ) /
                        ScaffoldModuleWidth
                    )
                );

            for (
                int xIndex = 0;
                xIndex <= xModules;
                xIndex++
            )
            {
                float x =
                    Mathf.Lerp(
                        -halfWidth,
                        halfWidth,
                        xIndex /
                        (float)xModules
                    );

                CreateBeamBetween(
                    new Vector3(
                        x,
                        y,
                        -halfDepth
                    ),
                    new Vector3(
                        x,
                        y,
                        halfDepth
                    ),
                    ScaffoldBeamThickness,
                    m_ScaffoldMetalMaterial
                );
            }

            for (
                int zIndex = 0;
                zIndex <= zModules;
                zIndex++
            )
            {
                float z =
                    Mathf.Lerp(
                        -halfDepth,
                        halfDepth,
                        zIndex /
                        (float)zModules
                    );

                CreateBeamBetween(
                    new Vector3(
                        -halfWidth,
                        y,
                        z
                    ),
                    new Vector3(
                        halfWidth,
                        y,
                        z
                    ),
                    ScaffoldBeamThickness,
                    m_ScaffoldMetalMaterial
                );
            }
        }

        // ============================================================
        // TOP WOODEN DECK
        // ============================================================

        private void CreateTopDeck(
            float halfWidth,
            float halfDepth,
            float y
        )
        {
            const float plankSpacing =
                0.70f;

            const float plankWidth =
                0.50f;

            const float plankHeight =
                0.10f;

            float totalDepth =
                halfDepth *
                2f;

            int plankCount =
                Math.Max(
                    1,
                    Mathf.CeilToInt(
                        totalDepth /
                        plankSpacing
                    )
                );

            for (
                int i = 0;
                i <= plankCount;
                i++
            )
            {
                float z =
                    Mathf.Lerp(
                        -halfDepth,
                        halfDepth,
                        i /
                        (float)plankCount
                    );

                CreateBox(
                    new Vector3(
                        0f,
                        y,
                        z
                    ),
                    new Vector3(
                        halfWidth *
                        2f,
                        plankHeight,
                        plankWidth
                    ),
                    m_ScaffoldDeckMaterial
                );
            }
        }

        // ============================================================
        // GEOMETRY HELPERS
        // ============================================================

        private void CreateBeamBetween(
            Vector3 start,
            Vector3 end,
            float thickness,
            Material material
        )
        {
            Vector3 direction =
                end -
                start;

            float length =
                direction.magnitude;

            if (
                length <
                0.001f
            )
            {
                return;
            }

            Vector3 center =
                (
                    start +
                    end
                ) *
                0.5f;

            GameObject beam =
                GameObject
                    .CreatePrimitive(
                        PrimitiveType.Cube
                    );

            beam.name =
                "ScaffoldBeam";

            beam.hideFlags =
                HideFlags.DontSave;

            beam.transform.SetParent(
                m_ScaffoldVisualRoot.transform,
                false
            );

            beam.transform.localPosition =
                center;

            beam.transform.localRotation =
                Quaternion.FromToRotation(
                    Vector3.forward,
                    direction.normalized
                );

            beam.transform.localScale =
                new Vector3(
                    thickness,
                    thickness,
                    length
                );

            MeshRenderer renderer =
                beam.GetComponent<MeshRenderer>();

            if (
                renderer != null &&
                material != null
            )
            {
                renderer.sharedMaterial =
                    material;
            }

            RemovePrimitiveCollider(
                beam
            );
        }

        private void CreateBox(
            Vector3 position,
            Vector3 size,
            Material material
        )
        {
            GameObject box =
                GameObject
                    .CreatePrimitive(
                        PrimitiveType.Cube
                    );

            box.name =
                "ScaffoldDeck";

            box.hideFlags =
                HideFlags.DontSave;

            box.transform.SetParent(
                m_ScaffoldVisualRoot.transform,
                false
            );

            box.transform.localPosition =
                position;

            box.transform.localRotation =
                Quaternion.identity;

            box.transform.localScale =
                size;

            MeshRenderer renderer =
                box.GetComponent<MeshRenderer>();

            if (
                renderer != null &&
                material != null
            )
            {
                renderer.sharedMaterial =
                    material;
            }

            RemovePrimitiveCollider(
                box
            );
        }

        private static void RemovePrimitiveCollider(
            GameObject gameObject
        )
        {
            if (
                gameObject ==
                null
            )
            {
                return;
            }

            try
            {
                Component component =
                    gameObject.GetComponent(
                        "BoxCollider"
                    );

                if (
                    component !=
                    null
                )
                {
                    UnityEngine.Object.Destroy(
                        component
                    );
                }
            }
            catch
            {
            }
        }

        // ============================================================
        // MATERIALS
        // ============================================================

        private void CreateScaffoldMaterials()
        {
            DestroyScaffoldMaterials();

            Shader shader =
                Shader.Find(
                    "HDRP/Lit"
                );

            if (
                shader ==
                null
            )
            {
                shader =
                    Shader.Find(
                        "Standard"
                    );
            }

            if (
                shader ==
                null
            )
            {
                ModLog.Info(
                    "V1.33.4 WARNING: no suitable scaffold shader found."
                );

                return;
            }

            // --------------------------------------------------------
            // METAL
            // --------------------------------------------------------

            m_ScaffoldMetalMaterial =
                new Material(
                    shader
                );

            m_ScaffoldMetalMaterial.name =
                "ConstructionAnimation_ScaffoldMetal";

            UnityEngine.Color metalColor =
                new UnityEngine.Color(
                    0.10f,
                    0.095f,
                    0.075f,
                    1f
                );

            SetMaterialColor(
                m_ScaffoldMetalMaterial,
                metalColor
            );

            if (
                m_ScaffoldMetalMaterial
                    .HasProperty(
                        "_Metallic"
                    )
            )
            {
                m_ScaffoldMetalMaterial
                    .SetFloat(
                        "_Metallic",
                        0.65f
                    );
            }

            if (
                m_ScaffoldMetalMaterial
                    .HasProperty(
                        "_Smoothness"
                    )
            )
            {
                m_ScaffoldMetalMaterial
                    .SetFloat(
                        "_Smoothness",
                        0.28f
                    );
            }

            // --------------------------------------------------------
            // WOOD
            // --------------------------------------------------------

            m_ScaffoldDeckMaterial =
                new Material(
                    shader
                );

            m_ScaffoldDeckMaterial.name =
                "ConstructionAnimation_ScaffoldDeck";

            UnityEngine.Color deckColor =
                new UnityEngine.Color(
                    0.46f,
                    0.32f,
                    0.16f,
                    1f
                );

            SetMaterialColor(
                m_ScaffoldDeckMaterial,
                deckColor
            );

            if (
                m_ScaffoldDeckMaterial
                    .HasProperty(
                        "_Metallic"
                    )
            )
            {
                m_ScaffoldDeckMaterial
                    .SetFloat(
                        "_Metallic",
                        0f
                    );
            }

            if (
                m_ScaffoldDeckMaterial
                    .HasProperty(
                        "_Smoothness"
                    )
            )
            {
                m_ScaffoldDeckMaterial
                    .SetFloat(
                        "_Smoothness",
                        0.12f
                    );
            }
        }

        private static void SetMaterialColor(
            Material material,
            UnityEngine.Color color
        )
        {
            if (
                material ==
                null
            )
            {
                return;
            }

            if (
                material.HasProperty(
                    "_BaseColor"
                )
            )
            {
                material.SetColor(
                    "_BaseColor",
                    color
                );
            }

            if (
                material.HasProperty(
                    "_Color"
                )
            )
            {
                material.SetColor(
                    "_Color",
                    color
                );
            }

            try
            {
                material.color =
                    color;
            }
            catch
            {
            }
        }

        // ============================================================
        // PROXY CLEANUP
        // ============================================================

        private void ScheduleNativeProxyDestroy()
        {
            if (
                m_VisualProxy ==
                Entity.Null
            )
            {
                return;
            }

            Entity proxy =
                m_VisualProxy;

            m_VisualProxy =
                Entity.Null;

            if (
                !EntityManager.Exists(
                    proxy
                )
            )
            {
                return;
            }

            try
            {
                if (
                    m_PendingProxyDestroy !=
                        Entity.Null &&
                    EntityManager.Exists(
                        m_PendingProxyDestroy
                    )
                )
                {
                    ForceDestroyPendingProxy();
                }

                if (
                    !EntityManager
                        .HasComponent<Deleted>(
                            proxy
                        )
                )
                {
                    EntityManager
                        .AddComponent<Deleted>(
                            proxy
                        );
                }

                if (
                    !EntityManager
                        .HasComponent<Updated>(
                            proxy
                        )
                )
                {
                    EntityManager
                        .AddComponent<Updated>(
                            proxy
                        );
                }

                m_PendingProxyDestroy =
                    proxy;

                m_PendingProxyDestroyFrames =
                    0;

                ModLog.Info(
                    $"V1.33.4 proxy scheduled for cleanup: " +
                    $"{proxy.Index}:{proxy.Version}"
                );
            }
            catch (Exception ex)
            {
                ModLog.Info(
                    $"V1.33.4 cleanup scheduling failed: " +
                    $"{ex.GetType().Name}: " +
                    $"{ex.Message}"
                );

                try
                {
                    if (
                        EntityManager.Exists(
                            proxy
                        )
                    )
                    {
                        EntityManager
                            .DestroyEntity(
                                proxy
                            );
                    }
                }
                catch
                {
                }
            }
        }

        private void ProcessPendingProxyDestroy()
        {
            if (
                m_PendingProxyDestroy ==
                Entity.Null
            )
            {
                return;
            }

            if (
                !EntityManager.Exists(
                    m_PendingProxyDestroy
                )
            )
            {
                ModLog.Info(
                    "V1.33.4 pending proxy removed by game systems."
                );

                m_PendingProxyDestroy =
                    Entity.Null;

                m_PendingProxyDestroyFrames =
                    0;

                return;
            }

            m_PendingProxyDestroyFrames++;

            try
            {
                if (
                    !EntityManager
                        .HasComponent<Deleted>(
                            m_PendingProxyDestroy
                        )
                )
                {
                    EntityManager
                        .AddComponent<Deleted>(
                            m_PendingProxyDestroy
                        );
                }

                if (
                    !EntityManager
                        .HasComponent<Updated>(
                            m_PendingProxyDestroy
                        )
                )
                {
                    EntityManager
                        .AddComponent<Updated>(
                            m_PendingProxyDestroy
                        );
                }
            }
            catch
            {
            }

            if (
                m_PendingProxyDestroyFrames <
                ProxyDestroyDelayFrames
            )
            {
                return;
            }

            Entity proxy =
                m_PendingProxyDestroy;

            try
            {
                if (
                    EntityManager.Exists(
                        proxy
                    )
                )
                {
                    EntityManager
                        .DestroyEntity(
                            proxy
                        );
                }

                ModLog.Info(
                    $"V1.33.4 proxy destroyed after renderer cleanup: " +
                    $"{proxy.Index}:{proxy.Version}"
                );
            }
            catch (Exception ex)
            {
                ModLog.Info(
                    $"V1.33.4 final proxy destroy failed: " +
                    $"{ex.GetType().Name}: " +
                    $"{ex.Message}"
                );
            }

            m_PendingProxyDestroy =
                Entity.Null;

            m_PendingProxyDestroyFrames =
                0;
        }

        private void ForceDestroyPendingProxy()
        {
            if (
                m_PendingProxyDestroy ==
                Entity.Null
            )
            {
                return;
            }

            Entity proxy =
                m_PendingProxyDestroy;

            try
            {
                if (
                    EntityManager.Exists(
                        proxy
                    )
                )
                {
                    EntityManager
                        .DestroyEntity(
                            proxy
                        );
                }
            }
            catch
            {
            }

            m_PendingProxyDestroy =
                Entity.Null;

            m_PendingProxyDestroyFrames =
                0;
        }

        // ============================================================
        // LOGGING
        // ============================================================

        private void LogProgress(
            UnderConstruction construction,
            float progress
        )
        {
            if (
                construction.m_Progress ==
                m_LastProgress
            )
            {
                return;
            }

            byte current =
                construction.m_Progress;

            if (
                current == 0 ||
                current == 1 ||
                current == 5 ||
                current == 10 ||
                current == 20 ||
                current == 25 ||
                current == 50 ||
                current == 75 ||
                current == 80 ||
                current == 90 ||
                current >= 98
            )
            {
                float visibleHeight;
                float descendOffset;

                if (
                    progress <=
                    ScaffoldRiseEnd
                )
                {
                    float growthProgress =
                        math.saturate(
                            progress /
                            ScaffoldRiseEnd
                        );

                    visibleHeight =
                        math.lerp(
                            math.min(
                                ScaffoldMinimumVisibleHeight,
                                m_ScaffoldHeight
                            ),
                            m_ScaffoldHeight,
                            growthProgress
                        );

                    descendOffset =
                        0f;
                }
                else
                {
                    visibleHeight =
                        m_ScaffoldHeight;

                    float p =
                        math.saturate(
                            (
                                progress -
                                ScaffoldRiseEnd
                            ) /
                            (
                                1f -
                                ScaffoldRiseEnd
                            )
                        );

                    descendOffset =
                        -(
                            m_ScaffoldHeight +
                            2f
                        ) *
                        p;
                }

                ModLog.Info(
                    $"V1.33.4 progress={current}% " +
                    $"scaffoldVisibleHeight={visibleHeight:0.00}m " +
                    $"scaffoldBottom={m_ScaffoldBottomY:0.00}m " +
                    $"descendOffset={descendOffset:0.00}m"
                );
            }

            m_LastProgress =
                current;
        }

        // ============================================================
        // ECS VISUAL COPY
        // ============================================================

        private void CopyVisualComponent<T>(
            Entity source
        )
            where T : unmanaged,
            IComponentData
        {
            if (
                !EntityManager
                    .HasComponent<T>(
                        source
                    )
            )
            {
                return;
            }

            T value =
                EntityManager
                    .GetComponentData<T>(
                        source
                    );

            if (
                EntityManager
                    .HasComponent<T>(
                        m_VisualProxy
                    )
            )
            {
                EntityManager
                    .SetComponentData(
                        m_VisualProxy,
                        value
                    );
            }
            else
            {
                EntityManager
                    .AddComponentData(
                        m_VisualProxy,
                        value
                    );
            }
        }

        private void CopyMeshColorBuffer(
            Entity source
        )
        {
            if (
                !EntityManager
                    .HasBuffer<MeshColor>(
                        m_VisualProxy
                    )
            )
            {
                EntityManager
                    .AddBuffer<MeshColor>(
                        m_VisualProxy
                    );
            }

            DynamicBuffer<MeshColor> target =
                EntityManager
                    .GetBuffer<MeshColor>(
                        m_VisualProxy
                    );

            target.Clear();

            if (
                !EntityManager
                    .HasBuffer<MeshColor>(
                        source
                    )
            )
            {
                return;
            }

            DynamicBuffer<MeshColor> sourceBuffer =
                EntityManager
                    .GetBuffer<MeshColor>(
                        source
                    );

            for (
                int i = 0;
                i < sourceBuffer.Length;
                i++
            )
            {
                target.Add(
                    sourceBuffer[i]
                );
            }
        }

        private void CopyCustomMeshColorBuffer(
            Entity source
        )
        {
            if (
                !EntityManager
                    .HasBuffer<CustomMeshColor>(
                        m_VisualProxy
                    )
            )
            {
                EntityManager
                    .AddBuffer<CustomMeshColor>(
                        m_VisualProxy
                    );
            }

            DynamicBuffer<CustomMeshColor> target =
                EntityManager
                    .GetBuffer<CustomMeshColor>(
                        m_VisualProxy
                    );

            target.Clear();

            if (
                !EntityManager
                    .HasBuffer<CustomMeshColor>(
                        source
                    )
            )
            {
                return;
            }

            DynamicBuffer<CustomMeshColor> sourceBuffer =
                EntityManager
                    .GetBuffer<CustomMeshColor>(
                        source
                    );

            for (
                int i = 0;
                i < sourceBuffer.Length;
                i++
            )
            {
                target.Add(
                    sourceBuffer[i]
                );
            }
        }

        // ============================================================
        // SCAFFOLD CLEANUP
        // ============================================================

        private void DestroyScaffold()
        {
            if (
                m_ScaffoldRoot !=
                null
            )
            {
                try
                {
                    UnityEngine.Object.Destroy(
                        m_ScaffoldRoot
                    );
                }
                catch
                {
                }
            }

            m_ScaffoldRoot =
                null;

            m_ScaffoldVisualRoot =
                null;

            m_ScaffoldHeight =
                0f;

            m_ScaffoldBottomY =
                0f;

            DestroyScaffoldMaterials();
        }

        private void DestroyScaffoldMaterials()
        {
            if (
                m_ScaffoldMetalMaterial !=
                null
            )
            {
                try
                {
                    UnityEngine.Object.Destroy(
                        m_ScaffoldMetalMaterial
                    );
                }
                catch
                {
                }

                m_ScaffoldMetalMaterial =
                    null;
            }

            if (
                m_ScaffoldDeckMaterial !=
                null
            )
            {
                try
                {
                    UnityEngine.Object.Destroy(
                        m_ScaffoldDeckMaterial
                    );
                }
                catch
                {
                }

                m_ScaffoldDeckMaterial =
                    null;
            }
        }

        // ============================================================
        // CURRENT CONSTRUCTION CLEANUP
        // ============================================================

        private void CleanupTrackedConstruction()
        {
            DestroyScaffold();

            ScheduleNativeProxyDestroy();

            m_TrackedBuilding =
                Entity.Null;

            m_LastProgress =
                255;
        }

        // ============================================================
        // SYSTEM SHUTDOWN
        // ============================================================

        protected override void OnDestroy()
        {
            DestroyScaffold();

            if (
                m_VisualProxy !=
                Entity.Null
            )
            {
                try
                {
                    if (
                        EntityManager.Exists(
                            m_VisualProxy
                        )
                    )
                    {
                        EntityManager
                            .DestroyEntity(
                                m_VisualProxy
                            );
                    }
                }
                catch
                {
                }

                m_VisualProxy =
                    Entity.Null;
            }

            ForceDestroyPendingProxy();

            m_TrackedBuilding =
                Entity.Null;

            base.OnDestroy();
        }
    }
}