using Colossal.IO.AssetDatabase;
using Game;
using Game.Buildings;
using Game.Common;
using Game.Objects;
using Game.Prefabs;
using Game.Rendering;
using System;
using System.Collections.Generic;
using System.Reflection;
using System.Reflection.Emit;
using Unity.Collections;
using Unity.Entities;
using Unity.Mathematics;
using UnityEngine;
using UnityEngine.Rendering;

namespace ConstructionAnimation.Systems
{
    public partial class ConstructionDetectionSystem : GameSystemBase
    {
        private EntityQuery m_BuildingQuery;

        private Entity m_TrackedBuilding = Entity.Null;
        private Entity m_VisualProxy = Entity.Null;

        private float m_BuildingHeight = 20f;
        private byte m_LastProgress = 255;

        private PrefabSystem m_PrefabSystem;

        private GameObject m_UnityRoot;
        private bool m_UnityCopyAttempted;

        private bool m_TargetedScanDone;

        private readonly List<GeometryAsset> m_LoadedGeometryAssets =
            new List<GeometryAsset>();

        private readonly List<SurfaceAsset> m_LoadedSurfaceAssets =
            new List<SurfaceAsset>();

        private static readonly Dictionary<short, OpCode> s_OpCodes =
            BuildOpCodeMap();

        protected override void OnCreate()
        {
            base.OnCreate();

            m_PrefabSystem =
                World.GetOrCreateSystemManaged<PrefabSystem>();

            m_BuildingQuery =
                GetEntityQuery(
                    ComponentType.ReadOnly<UnderConstruction>(),
                    ComponentType.ReadOnly<Building>(),
                    ComponentType.ReadOnly<PrefabRef>(),
                    ComponentType.ReadOnly<Game.Objects.Transform>()
                );

            ModLog.Info(
                "ConstructionAnimation V1.30 targeted renderer IL diagnostic created."
            );
        }

        protected override void OnUpdate()
        {
            if (
                m_TrackedBuilding == Entity.Null ||
                !EntityManager.Exists(m_TrackedBuilding) ||
                !EntityManager.HasComponent<UnderConstruction>(
                    m_TrackedBuilding
                )
            )
            {
                DestroyEverything();

                FindBuilding();

                if (m_TrackedBuilding == Entity.Null)
                    return;

                CreateNativeProxy(
                    m_TrackedBuilding
                );

                RunTargetedRendererScan();

                CreateUnityCopy();
            }

            if (
                m_VisualProxy == Entity.Null ||
                !EntityManager.Exists(m_VisualProxy)
            )
            {
                return;
            }

            UpdateProxyAnimation();
        }

        // ============================================================
        // BUILDING
        // ============================================================

        private void FindBuilding()
        {
            m_TrackedBuilding = Entity.Null;
            m_LastProgress = 255;
            m_UnityCopyAttempted = false;

            if (m_BuildingQuery.IsEmptyIgnoreFilter)
                return;

            using NativeArray<Entity> buildings =
                m_BuildingQuery.ToEntityArray(
                    Allocator.Temp
                );

            if (buildings.Length == 0)
                return;

            m_TrackedBuilding =
                buildings[0];

            PrefabRef prefabRef =
                EntityManager.GetComponentData<PrefabRef>(
                    m_TrackedBuilding
                );

            ModLog.Info(
                $"V1.30 tracking building " +
                $"{m_TrackedBuilding.Index}:" +
                $"{m_TrackedBuilding.Version}"
            );

            ModLog.Info(
                $"V1.30 source prefab = " +
                $"{prefabRef.m_Prefab.Index}:" +
                $"{prefabRef.m_Prefab.Version}"
            );
        }

        // ============================================================
        // NATIVE PROXY
        // ============================================================

        private void CreateNativeProxy(
            Entity source
        )
        {
            try
            {
                DestroyNativeProxy();

                PrefabRef prefabRef =
                    EntityManager.GetComponentData<PrefabRef>(
                        source
                    );

                Game.Objects.Transform transform =
                    EntityManager.GetComponentData<
                        Game.Objects.Transform
                    >(
                        source
                    );

                ReadBuildingHeight(
                    prefabRef.m_Prefab
                );

                EntityArchetype archetype =
                    EntityManager.CreateArchetype(
                        typeof(PrefabRef),
                        typeof(Game.Objects.Transform),
                        typeof(Game.Objects.Object),
                        typeof(Game.Objects.ObjectGeometry),
                        typeof(Game.Objects.Static),
                        typeof(Created),
                        typeof(Updated),
                        typeof(Unity.Entities.Simulate)
                    );

                m_VisualProxy =
                    EntityManager.CreateEntity(
                        archetype
                    );

                EntityManager.SetComponentData(
                    m_VisualProxy,
                    prefabRef
                );

                EntityManager.SetComponentData(
                    m_VisualProxy,
                    transform
                );

                CopyVisualComponent<CullingInfo>(
                    source
                );

                CopyVisualComponent<Game.Objects.Color>(
                    source
                );

                CopyVisualComponent<Game.Objects.Surface>(
                    source
                );

                CopyVisualComponent<PseudoRandomSeed>(
                    source
                );

                CopyMeshColorBuffer(
                    source
                );

                CopyCustomMeshColorBuffer(
                    source
                );

                if (
                    !EntityManager.HasBuffer<MeshBatch>(
                        m_VisualProxy
                    )
                )
                {
                    EntityManager.AddBuffer<MeshBatch>(
                        m_VisualProxy
                    );
                }

                ModLog.Info(
                    $"V1.30 native proxy = " +
                    $"{m_VisualProxy.Index}:" +
                    $"{m_VisualProxy.Version}"
                );

                ModLog.Info(
                    $"V1.30 building height = " +
                    $"{m_BuildingHeight:0.00} m"
                );

                UpdateProxyAnimation();
            }
            catch (Exception ex)
            {
                ModLog.Error(
                    $"V1.30 CreateNativeProxy failed: {ex}"
                );

                DestroyNativeProxy();
            }
        }

        private void ReadBuildingHeight(
            Entity prefab
        )
        {
            m_BuildingHeight = 20f;

            try
            {
                if (
                    !EntityManager.HasComponent<ObjectGeometryData>(
                        prefab
                    )
                )
                {
                    return;
                }

                ObjectGeometryData geometry =
                    EntityManager.GetComponentData<ObjectGeometryData>(
                        prefab
                    );

                float height =
                    geometry.m_Size.y;

                if (
                    height > 0.5f &&
                    height < 1000f
                )
                {
                    m_BuildingHeight =
                        height;
                }

                ModLog.Info(
                    $"V1.30 geometry size = {geometry.m_Size}"
                );

                ModLog.Info(
                    $"V1.30 geometry pivot = {geometry.m_Pivot}"
                );
            }
            catch (Exception ex)
            {
                ModLog.Info(
                    $"V1.30 ReadBuildingHeight failed: " +
                    $"{ex.GetType().Name}"
                );
            }
        }

        // ============================================================
        // ANIMATION
        // ============================================================

        private void UpdateProxyAnimation()
        {
            if (
                m_TrackedBuilding == Entity.Null ||
                m_VisualProxy == Entity.Null
            )
            {
                return;
            }

            if (
                !EntityManager.Exists(m_TrackedBuilding) ||
                !EntityManager.Exists(m_VisualProxy)
            )
            {
                return;
            }

            if (
                !EntityManager.HasComponent<UnderConstruction>(
                    m_TrackedBuilding
                )
            )
            {
                return;
            }

            Game.Objects.Transform sourceTransform =
                EntityManager.GetComponentData<
                    Game.Objects.Transform
                >(
                    m_TrackedBuilding
                );

            UnderConstruction construction =
                EntityManager.GetComponentData<
                    UnderConstruction
                >(
                    m_TrackedBuilding
                );

            float progress =
                math.saturate(
                    construction.m_Progress /
                    100f
                );

            float hiddenDistance =
                m_BuildingHeight + 0.5f;

            float verticalOffset =
                -hiddenDistance *
                (1f - progress);

            Game.Objects.Transform proxyTransform =
                sourceTransform;

            proxyTransform.m_Position.y +=
                verticalOffset;

            EntityManager.SetComponentData(
                m_VisualProxy,
                proxyTransform
            );

            MarkProxyUpdated();

            if (
                construction.m_Progress !=
                m_LastProgress
            )
            {
                byte current =
                    construction.m_Progress;

                if (
                    current == 0 ||
                    current == 10 ||
                    current == 25 ||
                    current == 50 ||
                    current == 75 ||
                    current == 90 ||
                    current >= 98
                )
                {
                    int meshBatchCount =
                        EntityManager.HasBuffer<MeshBatch>(
                            m_VisualProxy
                        )
                        ?
                        EntityManager
                            .GetBuffer<MeshBatch>(
                                m_VisualProxy
                            )
                            .Length
                        :
                        -1;

                    ModLog.Info(
                        $"V1.30 progress={current}% " +
                        $"offsetY={verticalOffset:0.00} m " +
                        $"MeshBatch={meshBatchCount}"
                    );
                }

                m_LastProgress =
                    current;
            }
        }

        private void MarkProxyUpdated()
        {
            if (
                m_VisualProxy == Entity.Null ||
                !EntityManager.Exists(
                    m_VisualProxy
                )
            )
            {
                return;
            }

            if (
                !EntityManager.HasComponent<Updated>(
                    m_VisualProxy
                )
            )
            {
                EntityManager.AddComponent<Updated>(
                    m_VisualProxy
                );
            }
        }

        // ============================================================
        // V1.30 TARGETED RENDERER REVERSE ENGINEERING
        // ============================================================

        private void RunTargetedRendererScan()
        {
            if (m_TargetedScanDone)
                return;

            m_TargetedScanDone = true;

            try
            {
                Assembly gameAssembly =
                    typeof(Building).Assembly;

                ModLog.Info(
                    "========== V1.30 TARGETED SCAN BEGIN =========="
                );

                DumpEnumOrStaticFields(
                    gameAssembly,
                    "Game.Rendering.ObjectProperty"
                );

                DumpEnumOrStaticFields(
                    gameAssembly,
                    "Game.Rendering.MaterialProperty"
                );

                DumpTypeMethods(
                    gameAssembly,
                    "Game.Rendering.BatchDataHelpers",
                    new string[]
                    {
                        "GetBuildingState",
                        "GetBoneParameters"
                    }
                );

                DumpTypeMethods(
                    gameAssembly,
                    "Game.Rendering.BatchMeshSystem",
                    new string[]
                    {
                        "SetShapeParameters"
                    }
                );

                DumpTypeMethods(
                    gameAssembly,
                    "Game.Rendering.BatchInstanceSystem+BatchInstanceJob",
                    new string[]
                    {
                        "Execute"
                    }
                );

                DumpTypeMethods(
                    gameAssembly,
                    "Game.Rendering.BatchDataSystem+BatchDataJob",
                    new string[]
                    {
                        "Execute"
                    }
                );

                DumpTypeMethods(
                    gameAssembly,
                    "Game.Rendering.Debug.RenderPrefabRenderer+Instance",
                    new string[]
                    {
                        "SetProceduralAnimationProperties",
                        "SetPropProperties",
                        "SetShapeProperties"
                    }
                );

                DumpTypeFields(
                    gameAssembly,
                    "Game.Rendering.BatchDataSystem"
                );

                DumpTypeFields(
                    gameAssembly,
                    "Game.Rendering.BatchDataSystem+BatchDataJob"
                );

                DumpTypeFields(
                    gameAssembly,
                    "Game.Rendering.BatchInstanceSystem+BatchInstanceJob"
                );

                DumpTypeFields(
                    gameAssembly,
                    "Game.Rendering.InstanceData"
                );

                DumpTypeFields(
                    gameAssembly,
                    "Game.Rendering.BatchData"
                );

                DumpTypeFields(
                    gameAssembly,
                    "Game.Rendering.PropertyData"
                );

                ModLog.Info(
                    "========== V1.30 TARGETED SCAN END =========="
                );
            }
            catch (Exception ex)
            {
                ModLog.Error(
                    $"V1.30 targeted scan failed: {ex}"
                );
            }
        }

        private void DumpEnumOrStaticFields(
            Assembly assembly,
            string typeName
        )
        {
            Type type =
                assembly.GetType(
                    typeName,
                    false
                );

            if (type == null)
            {
                ModLog.Info(
                    $"V1.30 TYPE NOT FOUND: {typeName}"
                );

                return;
            }

            ModLog.Info(
                $"----- V1.30 TYPE VALUES {type.FullName} -----"
            );

            FieldInfo[] fields =
                type.GetFields(
                    BindingFlags.Public |
                    BindingFlags.NonPublic |
                    BindingFlags.Static |
                    BindingFlags.Instance |
                    BindingFlags.DeclaredOnly
                );

            foreach (
                FieldInfo field
                in fields
            )
            {
                try
                {
                    string valueText =
                        "<instance>";

                    if (field.IsStatic)
                    {
                        object value =
                            field.GetValue(null);

                        valueText =
                            value != null
                            ? value.ToString()
                            : "<null>";
                    }

                    ModLog.Info(
                        $"V1.30 VALUE: " +
                        $"{type.FullName}.{field.Name} " +
                        $"type={field.FieldType.FullName} " +
                        $"value={valueText}"
                    );
                }
                catch (Exception ex)
                {
                    ModLog.Info(
                        $"V1.30 VALUE ERROR: " +
                        $"{type.FullName}.{field.Name} " +
                        $"{ex.GetType().Name}"
                    );
                }
            }
        }

        private void DumpTypeFields(
            Assembly assembly,
            string typeName
        )
        {
            Type type =
                assembly.GetType(
                    typeName,
                    false
                );

            if (type == null)
            {
                ModLog.Info(
                    $"V1.30 TYPE NOT FOUND: {typeName}"
                );

                return;
            }

            ModLog.Info(
                $"----- V1.30 FIELDS {type.FullName} -----"
            );

            FieldInfo[] fields =
                type.GetFields(
                    BindingFlags.Instance |
                    BindingFlags.Static |
                    BindingFlags.Public |
                    BindingFlags.NonPublic |
                    BindingFlags.DeclaredOnly
                );

            foreach (
                FieldInfo field
                in fields
            )
            {
                ModLog.Info(
                    $"V1.30 FIELD: " +
                    $"{field.Attributes} " +
                    $"{FormatType(field.FieldType)} " +
                    $"{field.Name}"
                );
            }
        }

        private void DumpTypeMethods(
            Assembly assembly,
            string typeName,
            string[] wantedNames
        )
        {
            Type type =
                assembly.GetType(
                    typeName,
                    false
                );

            if (type == null)
            {
                ModLog.Info(
                    $"V1.30 TYPE NOT FOUND: {typeName}"
                );

                return;
            }

            ModLog.Info(
                $"----- V1.30 METHODS {type.FullName} -----"
            );

            MethodInfo[] methods =
                type.GetMethods(
                    BindingFlags.Instance |
                    BindingFlags.Static |
                    BindingFlags.Public |
                    BindingFlags.NonPublic |
                    BindingFlags.DeclaredOnly
                );

            foreach (
                MethodInfo method
                in methods
            )
            {
                if (
                    wantedNames != null &&
                    wantedNames.Length > 0 &&
                    !ContainsExact(
                        wantedNames,
                        method.Name
                    )
                )
                {
                    continue;
                }

                DumpMethodSignature(
                    method
                );

                DumpMethodIL(
                    method
                );
            }
        }

        private void DumpMethodSignature(
            MethodInfo method
        )
        {
            try
            {
                ParameterInfo[] parameters =
                    method.GetParameters();

                string parameterText =
                    "";

                for (
                    int i = 0;
                    i < parameters.Length;
                    i++
                )
                {
                    if (i > 0)
                        parameterText += ", ";

                    ParameterInfo parameter =
                        parameters[i];

                    parameterText +=
                        $"{FormatType(parameter.ParameterType)} " +
                        $"{parameter.Name}";
                }

                ModLog.Info(
                    $"V1.30 METHOD: " +
                    $"{FormatType(method.ReturnType)} " +
                    $"{method.DeclaringType.FullName}." +
                    $"{method.Name}(" +
                    $"{parameterText}) " +
                    $"static={method.IsStatic}"
                );
            }
            catch (Exception ex)
            {
                ModLog.Info(
                    $"V1.30 METHOD SIGNATURE ERROR: " +
                    $"{method.Name} " +
                    $"{ex.GetType().Name}"
                );
            }
        }

        private void DumpMethodIL(
            MethodInfo method
        )
        {
            MethodBody body;

            try
            {
                body =
                    method.GetMethodBody();
            }
            catch (Exception ex)
            {
                ModLog.Info(
                    $"V1.30 IL unavailable: " +
                    $"{method.DeclaringType.FullName}." +
                    $"{method.Name} " +
                    $"{ex.GetType().Name}"
                );

                return;
            }

            if (body == null)
            {
                ModLog.Info(
                    $"V1.30 IL unavailable: " +
                    $"{method.DeclaringType.FullName}." +
                    $"{method.Name} body=null"
                );

                return;
            }

            byte[] il;

            try
            {
                il =
                    body.GetILAsByteArray();
            }
            catch (Exception ex)
            {
                ModLog.Info(
                    $"V1.30 IL read failed: " +
                    $"{method.DeclaringType.FullName}." +
                    $"{method.Name} " +
                    $"{ex.GetType().Name}"
                );

                return;
            }

            if (
                il == null ||
                il.Length == 0
            )
            {
                ModLog.Info(
                    $"V1.30 IL empty: " +
                    $"{method.DeclaringType.FullName}." +
                    $"{method.Name}"
                );

                return;
            }

            ModLog.Info(
                $"V1.30 IL BEGIN: " +
                $"{method.DeclaringType.FullName}." +
                $"{method.Name} bytes={il.Length}"
            );

            int position = 0;
            int instructionCount = 0;

            while (
                position < il.Length &&
                instructionCount < 2000
            )
            {
                int offset =
                    position;

                OpCode opcode =
                    ReadOpCode(
                        il,
                        ref position
                    );

                if (opcode.Size == 0)
                {
                    ModLog.Info(
                        $"V1.30 IL {offset:X4}: " +
                        "<unknown opcode>"
                    );

                    break;
                }

                string operandText =
                    "";

                try
                {
                    operandText =
                        ReadOperandText(
                            method,
                            opcode,
                            il,
                            ref position
                        );
                }
                catch (Exception ex)
                {
                    operandText =
                        $"<operand error {ex.GetType().Name}>";

                    int operandSize =
                        GetOperandSize(
                            opcode.OperandType,
                            il,
                            position
                        );

                    if (
                        operandSize > 0 &&
                        position + operandSize <= il.Length
                    )
                    {
                        position += operandSize;
                    }
                }

                if (
                    string.IsNullOrEmpty(
                        operandText
                    )
                )
                {
                    ModLog.Info(
                        $"V1.30 IL {offset:X4}: " +
                        $"{opcode.Name}"
                    );
                }
                else
                {
                    ModLog.Info(
                        $"V1.30 IL {offset:X4}: " +
                        $"{opcode.Name} " +
                        $"{operandText}"
                    );
                }

                instructionCount++;
            }

            ModLog.Info(
                $"V1.30 IL END: " +
                $"{method.DeclaringType.FullName}." +
                $"{method.Name} " +
                $"instructions={instructionCount}"
            );
        }

        private string ReadOperandText(
            MethodInfo method,
            OpCode opcode,
            byte[] il,
            ref int position
        )
        {
            OperandType operandType =
                opcode.OperandType;

            switch (operandType)
            {
                case OperandType.InlineNone:
                    return "";

                case OperandType.ShortInlineI:
                    {
                        sbyte value =
                            unchecked(
                                (sbyte)il[position]
                            );

                        position += 1;

                        return value.ToString();
                    }

                case OperandType.InlineI:
                    {
                        int value =
                            BitConverter.ToInt32(
                                il,
                                position
                            );

                        position += 4;

                        return value.ToString();
                    }

                case OperandType.InlineI8:
                    {
                        long value =
                            BitConverter.ToInt64(
                                il,
                                position
                            );

                        position += 8;

                        return value.ToString();
                    }

                case OperandType.ShortInlineR:
                    {
                        float value =
                            BitConverter.ToSingle(
                                il,
                                position
                            );

                        position += 4;

                        return value.ToString(
                            "R"
                        );
                    }

                case OperandType.InlineR:
                    {
                        double value =
                            BitConverter.ToDouble(
                                il,
                                position
                            );

                        position += 8;

                        return value.ToString(
                            "R"
                        );
                    }

                case OperandType.ShortInlineVar:
                    {
                        byte value =
                            il[position++];

                        return value.ToString();
                    }

                case OperandType.InlineVar:
                    {
                        ushort value =
                            BitConverter.ToUInt16(
                                il,
                                position
                            );

                        position += 2;

                        return value.ToString();
                    }

                case OperandType.ShortInlineBrTarget:
                    {
                        sbyte delta =
                            unchecked(
                                (sbyte)il[position]
                            );

                        position += 1;

                        int target =
                            position + delta;

                        return $"IL_{target:X4}";
                    }

                case OperandType.InlineBrTarget:
                    {
                        int delta =
                            BitConverter.ToInt32(
                                il,
                                position
                            );

                        position += 4;

                        int target =
                            position + delta;

                        return $"IL_{target:X4}";
                    }

                case OperandType.InlineString:
                    {
                        int token =
                            BitConverter.ToInt32(
                                il,
                                position
                            );

                        position += 4;

                        try
                        {
                            string value =
                                method.Module.ResolveString(
                                    token
                                );

                            return $"\"{value}\"";
                        }
                        catch
                        {
                            return $"string-token=0x{token:X8}";
                        }
                    }

                case OperandType.InlineField:
                    {
                        int token =
                            BitConverter.ToInt32(
                                il,
                                position
                            );

                        position += 4;

                        return ResolveMemberText(
                            method,
                            token,
                            "FIELD"
                        );
                    }

                case OperandType.InlineMethod:
                    {
                        int token =
                            BitConverter.ToInt32(
                                il,
                                position
                            );

                        position += 4;

                        return ResolveMemberText(
                            method,
                            token,
                            "METHOD"
                        );
                    }

                case OperandType.InlineType:
                    {
                        int token =
                            BitConverter.ToInt32(
                                il,
                                position
                            );

                        position += 4;

                        return ResolveMemberText(
                            method,
                            token,
                            "TYPE"
                        );
                    }

                case OperandType.InlineTok:
                    {
                        int token =
                            BitConverter.ToInt32(
                                il,
                                position
                            );

                        position += 4;

                        return ResolveMemberText(
                            method,
                            token,
                            "TOKEN"
                        );
                    }

                case OperandType.InlineSig:
                    {
                        int token =
                            BitConverter.ToInt32(
                                il,
                                position
                            );

                        position += 4;

                        return $"SIG 0x{token:X8}";
                    }

                case OperandType.InlineSwitch:
                    {
                        int count =
                            BitConverter.ToInt32(
                                il,
                                position
                            );

                        position += 4;

                        int basePosition =
                            position +
                            (count * 4);

                        string result =
                            "[";

                        for (
                            int i = 0;
                            i < count;
                            i++
                        )
                        {
                            int delta =
                                BitConverter.ToInt32(
                                    il,
                                    position
                                );

                            position += 4;

                            if (i > 0)
                                result += ", ";

                            result +=
                                $"IL_{basePosition + delta:X4}";
                        }

                        result += "]";

                        return result;
                    }

                default:
                    {
                        int size =
                            GetOperandSize(
                                operandType,
                                il,
                                position
                            );

                        if (size < 0)
                        {
                            return
                                $"<unsupported {operandType}>";
                        }

                        position += size;

                        return
                            $"<{operandType}>";
                    }
            }
        }

        private string ResolveMemberText(
            MethodInfo contextMethod,
            int token,
            string kind
        )
        {
            try
            {
                Type[] typeArguments =
                    contextMethod.DeclaringType != null &&
                    contextMethod.DeclaringType.IsGenericType
                    ?
                    contextMethod.DeclaringType
                        .GetGenericArguments()
                    :
                    null;

                Type[] methodArguments =
                    contextMethod.IsGenericMethod
                    ?
                    contextMethod
                        .GetGenericArguments()
                    :
                    null;

                MemberInfo member =
                    contextMethod.Module.ResolveMember(
                        token,
                        typeArguments,
                        methodArguments
                    );

                if (member == null)
                {
                    return
                        $"{kind} token=0x{token:X8}";
                }

                if (member is MethodBase method)
                {
                    return
                        $"{kind} " +
                        $"{FormatMethodBase(method)}";
                }

                if (member is FieldInfo field)
                {
                    return
                        $"{kind} " +
                        $"{field.DeclaringType?.FullName}." +
                        $"{field.Name}:" +
                        $"{FormatType(field.FieldType)}";
                }

                if (member is Type type)
                {
                    return
                        $"{kind} {type.FullName}";
                }

                return
                    $"{kind} " +
                    $"{member.DeclaringType?.FullName}." +
                    $"{member.Name}";
            }
            catch (Exception ex)
            {
                return
                    $"{kind} token=0x{token:X8} " +
                    $"<{ex.GetType().Name}>";
            }
        }

        private static string FormatMethodBase(
            MethodBase method
        )
        {
            if (method == null)
                return "<null method>";

            string parameters =
                "";

            try
            {
                ParameterInfo[] infos =
                    method.GetParameters();

                for (
                    int i = 0;
                    i < infos.Length;
                    i++
                )
                {
                    if (i > 0)
                        parameters += ", ";

                    parameters +=
                        FormatType(
                            infos[i].ParameterType
                        );
                }
            }
            catch
            {
            }

            string returnType =
                "void";

            if (method is MethodInfo info)
            {
                returnType =
                    FormatType(
                        info.ReturnType
                    );
            }

            return
                $"{returnType} " +
                $"{method.DeclaringType?.FullName}." +
                $"{method.Name}(" +
                $"{parameters})";
        }

        private static string FormatType(
            Type type
        )
        {
            if (type == null)
                return "<null>";

            if (type.IsByRef)
            {
                return
                    FormatType(
                        type.GetElementType()
                    ) +
                    "&";
            }

            if (type.IsArray)
            {
                return
                    FormatType(
                        type.GetElementType()
                    ) +
                    "[]";
            }

            return
                type.FullName ??
                type.Name;
        }

        private static bool ContainsExact(
            string[] values,
            string wanted
        )
        {
            foreach (
                string value
                in values
            )
            {
                if (
                    string.Equals(
                        value,
                        wanted,
                        StringComparison.Ordinal
                    )
                )
                {
                    return true;
                }
            }

            return false;
        }

        // ============================================================
        // IL HELPERS
        // ============================================================

        private static Dictionary<short, OpCode>
            BuildOpCodeMap()
        {
            Dictionary<short, OpCode> result =
                new Dictionary<short, OpCode>();

            FieldInfo[] fields =
                typeof(OpCodes).GetFields(
                    BindingFlags.Public |
                    BindingFlags.Static
                );

            foreach (
                FieldInfo field
                in fields
            )
            {
                if (
                    field.FieldType !=
                    typeof(OpCode)
                )
                {
                    continue;
                }

                try
                {
                    OpCode opcode =
                        (OpCode)field.GetValue(
                            null
                        );

                    result[opcode.Value] =
                        opcode;
                }
                catch
                {
                }
            }

            return result;
        }

        private static OpCode ReadOpCode(
            byte[] il,
            ref int position
        )
        {
            if (
                position >=
                il.Length
            )
            {
                return default(OpCode);
            }

            byte first =
                il[position++];

            short value;

            if (first == 0xFE)
            {
                if (
                    position >=
                    il.Length
                )
                {
                    return default(OpCode);
                }

                byte second =
                    il[position++];

                value =
                    unchecked(
                        (short)(
                            0xFE00 |
                            second
                        )
                    );
            }
            else
            {
                value =
                    first;
            }

            if (
                s_OpCodes.TryGetValue(
                    value,
                    out OpCode opcode
                )
            )
            {
                return opcode;
            }

            return default(OpCode);
        }

        private static int GetOperandSize(
            OperandType operandType,
            byte[] il,
            int position
        )
        {
            switch (operandType)
            {
                case OperandType.InlineNone:
                    return 0;

                case OperandType.ShortInlineBrTarget:
                case OperandType.ShortInlineI:
                case OperandType.ShortInlineVar:
                    return 1;

                case OperandType.InlineVar:
                    return 2;

                case OperandType.InlineBrTarget:
                case OperandType.InlineField:
                case OperandType.InlineI:
                case OperandType.InlineMethod:
                case OperandType.InlineSig:
                case OperandType.InlineString:
                case OperandType.InlineTok:
                case OperandType.InlineType:
                case OperandType.ShortInlineR:
                    return 4;

                case OperandType.InlineI8:
                case OperandType.InlineR:
                    return 8;

                case OperandType.InlineSwitch:
                    {
                        if (
                            position + 4 >
                            il.Length
                        )
                        {
                            return -1;
                        }

                        int count =
                            BitConverter.ToInt32(
                                il,
                                position
                            );

                        if (count < 0)
                            return -1;

                        return
                            4 +
                            (count * 4);
                    }

                default:
                    return -1;
            }
        }

        // ============================================================
        // UNITY TEST COPY
        // ============================================================

        private void CreateUnityCopy()
        {
            if (m_UnityCopyAttempted)
                return;

            m_UnityCopyAttempted =
                true;

            try
            {
                PrefabRef prefabRef =
                    EntityManager.GetComponentData<PrefabRef>(
                        m_TrackedBuilding
                    );

                Entity buildingPrefab =
                    prefabRef.m_Prefab;

                if (
                    !EntityManager.HasBuffer<SubMesh>(
                        buildingPrefab
                    )
                )
                {
                    return;
                }

                DynamicBuffer<SubMesh> subMeshes =
                    EntityManager.GetBuffer<SubMesh>(
                        buildingPrefab
                    );

                ModLog.Info(
                    $"V1.30 Unity copy: " +
                    $"SubMesh count={subMeshes.Length}"
                );

                Game.Objects.Transform sourceTransform =
                    EntityManager.GetComponentData<
                        Game.Objects.Transform
                    >(
                        m_TrackedBuilding
                    );

                m_UnityRoot =
                    new GameObject(
                        "ConstructionAnimation_V1_30_UnityCopy"
                    );

                float3 sideOffset =
                    math.rotate(
                        sourceTransform.m_Rotation,
                        new float3(
                            35f,
                            0f,
                            0f
                        )
                    );

                float3 rootPosition =
                    sourceTransform.m_Position +
                    sideOffset;

                m_UnityRoot.transform.position =
                    new Vector3(
                        rootPosition.x,
                        rootPosition.y,
                        rootPosition.z
                    );

                quaternion sourceRotation =
                    sourceTransform.m_Rotation;

                m_UnityRoot.transform.rotation =
                    new Quaternion(
                        sourceRotation.value.x,
                        sourceRotation.value.y,
                        sourceRotation.value.z,
                        sourceRotation.value.w
                    );

                int rendererCount =
                    0;

                for (
                    int i = 0;
                    i < subMeshes.Length;
                    i++
                )
                {
                    rendererCount +=
                        CreateUnitySubMesh(
                            subMeshes[i],
                            i
                        );
                }

                ModLog.Info(
                    $"V1.30 UNITY COPY CREATED: " +
                    $"renderers={rendererCount}"
                );
            }
            catch (Exception ex)
            {
                ModLog.Error(
                    $"V1.30 CreateUnityCopy failed: {ex}"
                );
            }
        }

        private int CreateUnitySubMesh(
            SubMesh subMesh,
            int prefabSubMeshIndex
        )
        {
            try
            {
                Entity renderPrefabEntity =
                    subMesh.m_SubMesh;

                if (
                    renderPrefabEntity == Entity.Null ||
                    !EntityManager.Exists(
                        renderPrefabEntity
                    )
                )
                {
                    return 0;
                }

                PrefabBase managedPrefab =
                    m_PrefabSystem.GetPrefab<PrefabBase>(
                        renderPrefabEntity
                    );

                if (managedPrefab == null)
                    return 0;

                GeometryAsset geometryAsset =
                    GetGeometryAsset(
                        managedPrefab
                    );

                if (geometryAsset == null)
                    return 0;

                Mesh[] meshes =
                    geometryAsset.ObtainMeshes(
                        true
                    );

                if (
                    meshes == null ||
                    meshes.Length == 0
                )
                {
                    return 0;
                }

                if (
                    !m_LoadedGeometryAssets.Contains(
                        geometryAsset
                    )
                )
                {
                    m_LoadedGeometryAssets.Add(
                        geometryAsset
                    );
                }

                Material[] materials =
                    LoadBestMaterials(
                        managedPrefab
                    );

                ModLog.Info(
                    $"V1.30 render prefab: " +
                    $"meshes={meshes.Length}, " +
                    $"materials={materials.Length}"
                );

                int created =
                    0;

                for (
                    int meshIndex = 0;
                    meshIndex < meshes.Length;
                    meshIndex++
                )
                {
                    Mesh mesh =
                        meshes[meshIndex];

                    if (mesh == null)
                        continue;

                    GameObject child =
                        new GameObject(
                            $"V1_30_Mesh_" +
                            $"{prefabSubMeshIndex}_" +
                            $"{meshIndex}"
                        );

                    child.transform.SetParent(
                        m_UnityRoot.transform,
                        false
                    );

                    child.transform.localPosition =
                        new Vector3(
                            subMesh.m_Position.x,
                            subMesh.m_Position.y,
                            subMesh.m_Position.z
                        );

                    quaternion q =
                        subMesh.m_Rotation;

                    child.transform.localRotation =
                        new Quaternion(
                            q.value.x,
                            q.value.y,
                            q.value.z,
                            q.value.w
                        );

                    MeshFilter filter =
                        child.AddComponent<MeshFilter>();

                    MeshRenderer renderer =
                        child.AddComponent<MeshRenderer>();

                    filter.sharedMesh =
                        mesh;

                    Material[] mappedMaterials =
                        BuildMaterialArray(
                            mesh,
                            materials,
                            meshIndex
                        );

                    renderer.sharedMaterials =
                        mappedMaterials;

                    ApplyDiagnosticPropertyBlock(
                        renderer,
                        mappedMaterials
                    );

                    created++;
                }

                return created;
            }
            catch (Exception ex)
            {
                ModLog.Error(
                    $"V1.30 CreateUnitySubMesh failed: {ex}"
                );

                return 0;
            }
        }

        private void ApplyDiagnosticPropertyBlock(
            MeshRenderer renderer,
            Material[] materials
        )
        {
            if (
                renderer == null ||
                materials == null ||
                materials.Length == 0
            )
            {
                return;
            }

            try
            {
                MaterialPropertyBlock block =
                    new MaterialPropertyBlock();

                foreach (
                    Material material
                    in materials
                )
                {
                    if (
                        material == null ||
                        material.shader == null
                    )
                    {
                        continue;
                    }

                    Shader shader =
                        material.shader;

                    int propertyCount =
                        shader.GetPropertyCount();

                    for (
                        int i = 0;
                        i < propertyCount;
                        i++
                    )
                    {
                        string name =
                            shader.GetPropertyName(i);

                        if (
                            string.IsNullOrEmpty(name) ||
                            !name.StartsWith(
                                "colossal_",
                                StringComparison.OrdinalIgnoreCase
                            )
                        )
                        {
                            continue;
                        }

                        CopyShaderProperty(
                            block,
                            material,
                            name,
                            shader.GetPropertyType(i)
                        );
                    }
                }

                renderer.SetPropertyBlock(
                    block
                );
            }
            catch (Exception ex)
            {
                ModLog.Info(
                    $"V1.30 MPB failed: " +
                    $"{ex.GetType().Name}"
                );
            }
        }

        private void CopyShaderProperty(
            MaterialPropertyBlock block,
            Material material,
            string propertyName,
            ShaderPropertyType propertyType
        )
        {
            try
            {
                int id =
                    Shader.PropertyToID(
                        propertyName
                    );

                switch (propertyType)
                {
                    case ShaderPropertyType.Float:
                    case ShaderPropertyType.Range:
                        block.SetFloat(
                            id,
                            material.GetFloat(id)
                        );
                        break;

                    case ShaderPropertyType.Vector:
                        block.SetVector(
                            id,
                            material.GetVector(id)
                        );
                        break;

                    case ShaderPropertyType.Color:
                        block.SetColor(
                            id,
                            material.GetColor(id)
                        );
                        break;

                    case ShaderPropertyType.Texture:
                        {
                            Texture texture =
                                material.GetTexture(id);

                            if (texture != null)
                            {
                                block.SetTexture(
                                    id,
                                    texture
                                );
                            }

                            break;
                        }
                }
            }
            catch
            {
            }
        }

        // ============================================================
        // GEOMETRY / MATERIALS
        // ============================================================

        private GeometryAsset GetGeometryAsset(
            object renderPrefab
        )
        {
            if (renderPrefab == null)
                return null;

            try
            {
                FieldInfo field =
                    renderPrefab
                        .GetType()
                        .GetField(
                            "m_GeometryAsset",
                            BindingFlags.Instance |
                            BindingFlags.Public |
                            BindingFlags.NonPublic
                        );

                if (field == null)
                    return null;

                object reference =
                    field.GetValue(
                        renderPrefab
                    );

                return ConvertAssetReference<GeometryAsset>(
                    reference
                );
            }
            catch
            {
                return null;
            }
        }

        private Material[] LoadBestMaterials(
            object renderPrefab
        )
        {
            if (renderPrefab == null)
                return Array.Empty<Material>();

            try
            {
                FieldInfo field =
                    renderPrefab
                        .GetType()
                        .GetField(
                            "m_SurfaceAssets",
                            BindingFlags.Instance |
                            BindingFlags.Public |
                            BindingFlags.NonPublic
                        );

                if (field == null)
                    return Array.Empty<Material>();

                Array references =
                    field.GetValue(
                        renderPrefab
                    ) as Array;

                if (references == null)
                    return Array.Empty<Material>();

                List<Material> result =
                    new List<Material>();

                for (
                    int i = 0;
                    i < references.Length;
                    i++
                )
                {
                    object reference =
                        references.GetValue(i);

                    SurfaceAsset surface =
                        ConvertAssetReference<SurfaceAsset>(
                            reference
                        );

                    if (surface == null)
                        continue;

                    Material material =
                        LoadSurfaceBestEffort(
                            surface,
                            i
                        );

                    if (material == null)
                        continue;

                    result.Add(
                        material
                    );

                    if (
                        !m_LoadedSurfaceAssets.Contains(
                            surface
                        )
                    )
                    {
                        m_LoadedSurfaceAssets.Add(
                            surface
                        );
                    }

                    ModLog.Info(
                        $"V1.30 Surface[{i}] " +
                        $"material={material.name}, " +
                        $"shader={material.shader?.name}"
                    );
                }

                return result.ToArray();
            }
            catch (Exception ex)
            {
                ModLog.Info(
                    $"V1.30 LoadBestMaterials failed: " +
                    $"{ex.GetType().Name}"
                );

                return Array.Empty<Material>();
            }
        }

        private Material LoadSurfaceBestEffort(
            SurfaceAsset surface,
            int surfaceIndex
        )
        {
            MethodInfo[] methods =
                surface.GetType().GetMethods(
                    BindingFlags.Instance |
                    BindingFlags.Public |
                    BindingFlags.NonPublic
                );

            foreach (
                MethodInfo method
                in methods
            )
            {
                if (
                    method.Name != "Load" ||
                    !typeof(Material).IsAssignableFrom(
                        method.ReturnType
                    )
                )
                {
                    continue;
                }

                ParameterInfo[] parameters =
                    method.GetParameters();

                if (
                    parameters.Length != 4 ||
                    parameters[0].ParameterType != typeof(int) ||
                    parameters[1].ParameterType != typeof(bool) ||
                    parameters[3].ParameterType != typeof(bool)
                )
                {
                    continue;
                }

                try
                {
                    object keepOnCpu =
                        Activator.CreateInstance(
                            parameters[2].ParameterType
                        );

                    Material material =
                        method.Invoke(
                            surface,
                            new object[]
                            {
                                0,
                                true,
                                keepOnCpu,
                                true
                            }
                        ) as Material;

                    if (material != null)
                    {
                        ModLog.Info(
                            $"V1.30 Surface[{surfaceIndex}] " +
                            $"Load(useVT=true) OK"
                        );

                        return material;
                    }
                }
                catch
                {
                }

                try
                {
                    object keepOnCpu =
                        Activator.CreateInstance(
                            parameters[2].ParameterType
                        );

                    Material material =
                        method.Invoke(
                            surface,
                            new object[]
                            {
                                0,
                                true,
                                keepOnCpu,
                                false
                            }
                        ) as Material;

                    if (material != null)
                        return material;
                }
                catch
                {
                }
            }

            return null;
        }

        private static T ConvertAssetReference<T>(
            object assetReference
        )
            where T : class
        {
            if (assetReference == null)
                return null;

            try
            {
                Type referenceType =
                    assetReference.GetType();

                MethodInfo[] methods =
                    referenceType.GetMethods(
                        BindingFlags.Static |
                        BindingFlags.Public |
                        BindingFlags.NonPublic
                    );

                foreach (
                    MethodInfo method
                    in methods
                )
                {
                    if (
                        method.Name != "op_Implicit" ||
                        !typeof(T).IsAssignableFrom(
                            method.ReturnType
                        )
                    )
                    {
                        continue;
                    }

                    ParameterInfo[] parameters =
                        method.GetParameters();

                    if (parameters.Length != 1)
                        continue;

                    object result =
                        method.Invoke(
                            null,
                            new object[]
                            {
                                assetReference
                            }
                        );

                    return result as T;
                }
            }
            catch
            {
            }

            return null;
        }

        private static Material[]
            BuildMaterialArray(
                Mesh mesh,
                Material[] materials,
                int meshIndex
            )
        {
            if (
                mesh == null ||
                materials == null ||
                materials.Length == 0
            )
            {
                return Array.Empty<Material>();
            }

            int subMeshCount =
                Math.Max(
                    1,
                    mesh.subMeshCount
                );

            Material[] result =
                new Material[subMeshCount];

            for (
                int subMeshIndex = 0;
                subMeshIndex < subMeshCount;
                subMeshIndex++
            )
            {
                int materialIndex =
                    Math.Min(
                        meshIndex + subMeshIndex,
                        materials.Length - 1
                    );

                result[subMeshIndex] =
                    materials[materialIndex];
            }

            return result;
        }

        // ============================================================
        // ECS COPY
        // ============================================================

        private void CopyVisualComponent<T>(
            Entity source
        )
            where T : unmanaged,
            IComponentData
        {
            if (
                !EntityManager.HasComponent<T>(
                    source
                )
            )
            {
                return;
            }

            T value =
                EntityManager.GetComponentData<T>(
                    source
                );

            if (
                EntityManager.HasComponent<T>(
                    m_VisualProxy
                )
            )
            {
                EntityManager.SetComponentData(
                    m_VisualProxy,
                    value
                );
            }
            else
            {
                EntityManager.AddComponentData(
                    m_VisualProxy,
                    value
                );
            }
        }

        private void CopyMeshColorBuffer(
            Entity source
        )
        {
            if (
                !EntityManager.HasBuffer<MeshColor>(
                    m_VisualProxy
                )
            )
            {
                EntityManager.AddBuffer<MeshColor>(
                    m_VisualProxy
                );
            }

            DynamicBuffer<MeshColor> target =
                EntityManager.GetBuffer<MeshColor>(
                    m_VisualProxy
                );

            target.Clear();

            if (
                !EntityManager.HasBuffer<MeshColor>(
                    source
                )
            )
            {
                return;
            }

            DynamicBuffer<MeshColor> sourceBuffer =
                EntityManager.GetBuffer<MeshColor>(
                    source
                );

            for (
                int i = 0;
                i < sourceBuffer.Length;
                i++
            )
            {
                target.Add(
                    sourceBuffer[i]
                );
            }
        }

        private void CopyCustomMeshColorBuffer(
            Entity source
        )
        {
            if (
                !EntityManager.HasBuffer<CustomMeshColor>(
                    m_VisualProxy
                )
            )
            {
                EntityManager.AddBuffer<CustomMeshColor>(
                    m_VisualProxy
                );
            }

            DynamicBuffer<CustomMeshColor> target =
                EntityManager.GetBuffer<CustomMeshColor>(
                    m_VisualProxy
                );

            target.Clear();

            if (
                !EntityManager.HasBuffer<CustomMeshColor>(
                    source
                )
            )
            {
                return;
            }

            DynamicBuffer<CustomMeshColor> sourceBuffer =
                EntityManager.GetBuffer<CustomMeshColor>(
                    source
                );

            for (
                int i = 0;
                i < sourceBuffer.Length;
                i++
            )
            {
                target.Add(
                    sourceBuffer[i]
                );
            }
        }

        // ============================================================
        // CLEANUP
        // ============================================================

        private void DestroyNativeProxy()
        {
            if (
                m_VisualProxy != Entity.Null &&
                EntityManager.Exists(
                    m_VisualProxy
                )
            )
            {
                try
                {
                    EntityManager.DestroyEntity(
                        m_VisualProxy
                    );
                }
                catch
                {
                }
            }

            m_VisualProxy =
                Entity.Null;
        }

        private void DestroyUnityCopy()
        {
            if (m_UnityRoot != null)
            {
                try
                {
                    UnityEngine.Object.Destroy(
                        m_UnityRoot
                    );
                }
                catch
                {
                }

                m_UnityRoot = null;
            }

            foreach (
                GeometryAsset geometry
                in m_LoadedGeometryAssets
            )
            {
                if (geometry == null)
                    continue;

                try
                {
                    geometry.ReleaseMeshes();
                }
                catch
                {
                }
            }

            m_LoadedGeometryAssets.Clear();

            foreach (
                SurfaceAsset surface
                in m_LoadedSurfaceAssets
            )
            {
                if (surface == null)
                    continue;

                TryUnloadSurface(
                    surface
                );
            }

            m_LoadedSurfaceAssets.Clear();
        }

        private static void TryUnloadSurface(
            SurfaceAsset surface
        )
        {
            try
            {
                MethodInfo[] methods =
                    surface.GetType().GetMethods(
                        BindingFlags.Instance |
                        BindingFlags.Public |
                        BindingFlags.NonPublic
                    );

                foreach (
                    MethodInfo method
                    in methods
                )
                {
                    if (
                        method.Name == "Unload" &&
                        method.GetParameters().Length == 0
                    )
                    {
                        method.Invoke(
                            surface,
                            null
                        );

                        return;
                    }
                }
            }
            catch
            {
            }
        }

        private void DestroyEverything()
        {
            DestroyNativeProxy();
            DestroyUnityCopy();

            m_TrackedBuilding =
                Entity.Null;

            m_UnityCopyAttempted =
                false;

            m_LastProgress =
                255;
        }

        protected override void OnDestroy()
        {
            DestroyEverything();

            base.OnDestroy();
        }
    }
}