using Game;
using Game.Buildings;
using Game.Common;
using Game.Objects;
using Game.Prefabs;
using Game.Rendering;
using System;
using System.Collections.Generic;
using System.Reflection;
using System.Reflection.Emit;
using Unity.Collections;
using Unity.Entities;
using Unity.Mathematics;

namespace ConstructionAnimation.Systems
{
    public partial class ConstructionDetectionSystem : GameSystemBase
    {
        private EntityQuery m_BuildingQuery;

        private Entity m_TrackedBuilding = Entity.Null;
        private Entity m_VisualProxy = Entity.Null;

        private float m_BuildingHeight = 20f;
        private byte m_LastProgress = 255;

        private bool m_FieldScanDone;

        private static readonly Dictionary<short, OpCode> s_OpCodes =
            BuildOpCodeMap();

        protected override void OnCreate()
        {
            base.OnCreate();

            m_BuildingQuery =
                GetEntityQuery(
                    ComponentType.ReadOnly<UnderConstruction>(),
                    ComponentType.ReadOnly<Building>(),
                    ComponentType.ReadOnly<PrefabRef>(),
                    ComponentType.ReadOnly<Game.Objects.Transform>()
                );

            ModLog.Info(
                "ConstructionAnimation V1.32 UnderConstruction field-reference scanner created."
            );
        }

        protected override void OnUpdate()
        {
            if (
                m_TrackedBuilding == Entity.Null ||
                !EntityManager.Exists(m_TrackedBuilding) ||
                !EntityManager.HasComponent<UnderConstruction>(
                    m_TrackedBuilding
                )
            )
            {
                DestroyEverything();

                FindBuilding();

                if (m_TrackedBuilding == Entity.Null)
                {
                    return;
                }

                CreateNativeProxy(
                    m_TrackedBuilding
                );

                RunUnderConstructionFieldScan();
            }

            if (
                m_VisualProxy == Entity.Null ||
                !EntityManager.Exists(m_VisualProxy)
            )
            {
                return;
            }

            UpdateProxyAnimation();
        }

        // ============================================================
        // BUILDING DETECTION
        // ============================================================

        private void FindBuilding()
        {
            m_TrackedBuilding =
                Entity.Null;

            m_LastProgress =
                255;

            if (
                m_BuildingQuery
                    .IsEmptyIgnoreFilter
            )
            {
                return;
            }

            using NativeArray<Entity> buildings =
                m_BuildingQuery
                    .ToEntityArray(
                        Allocator.Temp
                    );

            if (
                buildings.Length ==
                0
            )
            {
                return;
            }

            m_TrackedBuilding =
                buildings[0];

            PrefabRef prefabRef =
                EntityManager
                    .GetComponentData<PrefabRef>(
                        m_TrackedBuilding
                    );

            UnderConstruction construction =
                EntityManager
                    .GetComponentData<UnderConstruction>(
                        m_TrackedBuilding
                    );

            ModLog.Info(
                $"V1.32 tracking building " +
                $"{m_TrackedBuilding.Index}:" +
                $"{m_TrackedBuilding.Version}"
            );

            ModLog.Info(
                $"V1.32 source prefab = " +
                $"{prefabRef.m_Prefab.Index}:" +
                $"{prefabRef.m_Prefab.Version}"
            );

            ModLog.Info(
                $"V1.32 UnderConstruction initial: " +
                $"progress={construction.m_Progress}, " +
                $"speed={construction.m_Speed}, " +
                $"newPrefab=" +
                $"{construction.m_NewPrefab.Index}:" +
                $"{construction.m_NewPrefab.Version}, " +
                $"newPrefabNull=" +
                $"{construction.m_NewPrefab == Entity.Null}"
            );
        }

        // ============================================================
        // NATIVE VISUAL PROXY
        // BASELINE THAT ALREADY WORKS
        // ============================================================

        private void CreateNativeProxy(
            Entity source
        )
        {
            try
            {
                DestroyNativeProxy();

                PrefabRef prefabRef =
                    EntityManager
                        .GetComponentData<PrefabRef>(
                            source
                        );

                Game.Objects.Transform transform =
                    EntityManager
                        .GetComponentData<
                            Game.Objects.Transform
                        >(
                            source
                        );

                ReadBuildingHeight(
                    prefabRef.m_Prefab
                );

                EntityArchetype archetype =
                    EntityManager
                        .CreateArchetype(
                            typeof(PrefabRef),
                            typeof(Game.Objects.Transform),
                            typeof(Game.Objects.Object),
                            typeof(Game.Objects.ObjectGeometry),
                            typeof(Game.Objects.Static),
                            typeof(Created),
                            typeof(Updated),
                            typeof(Unity.Entities.Simulate)
                        );

                m_VisualProxy =
                    EntityManager
                        .CreateEntity(
                            archetype
                        );

                EntityManager.SetComponentData(
                    m_VisualProxy,
                    prefabRef
                );

                EntityManager.SetComponentData(
                    m_VisualProxy,
                    transform
                );

                CopyVisualComponent<CullingInfo>(
                    source
                );

                CopyVisualComponent<
                    Game.Objects.Color
                >(
                    source
                );

                CopyVisualComponent<
                    Game.Objects.Surface
                >(
                    source
                );

                CopyVisualComponent<
                    PseudoRandomSeed
                >(
                    source
                );

                CopyMeshColorBuffer(
                    source
                );

                CopyCustomMeshColorBuffer(
                    source
                );

                if (
                    !EntityManager
                        .HasBuffer<MeshBatch>(
                            m_VisualProxy
                        )
                )
                {
                    EntityManager
                        .AddBuffer<MeshBatch>(
                            m_VisualProxy
                        );
                }

                ModLog.Info(
                    $"V1.32 native proxy = " +
                    $"{m_VisualProxy.Index}:" +
                    $"{m_VisualProxy.Version}"
                );

                ModLog.Info(
                    $"V1.32 building height = " +
                    $"{m_BuildingHeight:0.00} m"
                );

                UpdateProxyAnimation();
            }
            catch (Exception ex)
            {
                ModLog.Error(
                    $"V1.32 CreateNativeProxy failed: {ex}"
                );

                DestroyNativeProxy();
            }
        }

        private void ReadBuildingHeight(
            Entity prefab
        )
        {
            m_BuildingHeight =
                20f;

            try
            {
                if (
                    !EntityManager
                        .HasComponent<ObjectGeometryData>(
                            prefab
                        )
                )
                {
                    return;
                }

                ObjectGeometryData geometry =
                    EntityManager
                        .GetComponentData<ObjectGeometryData>(
                            prefab
                        );

                float height =
                    geometry.m_Size.y;

                if (
                    height > 0.5f &&
                    height < 1000f
                )
                {
                    m_BuildingHeight =
                        height;
                }

                ModLog.Info(
                    $"V1.32 geometry size = " +
                    $"{geometry.m_Size}"
                );

                ModLog.Info(
                    $"V1.32 geometry pivot = " +
                    $"{geometry.m_Pivot}"
                );
            }
            catch (Exception ex)
            {
                ModLog.Info(
                    $"V1.32 ReadBuildingHeight failed: " +
                    $"{ex.GetType().Name}"
                );
            }
        }

        // ============================================================
        // CURRENT PROGRESS ANIMATION
        // ============================================================

        private void UpdateProxyAnimation()
        {
            if (
                m_TrackedBuilding == Entity.Null ||
                m_VisualProxy == Entity.Null
            )
            {
                return;
            }

            if (
                !EntityManager.Exists(
                    m_TrackedBuilding
                ) ||
                !EntityManager.Exists(
                    m_VisualProxy
                )
            )
            {
                return;
            }

            if (
                !EntityManager
                    .HasComponent<UnderConstruction>(
                        m_TrackedBuilding
                    )
            )
            {
                return;
            }

            Game.Objects.Transform sourceTransform =
                EntityManager
                    .GetComponentData<
                        Game.Objects.Transform
                    >(
                        m_TrackedBuilding
                    );

            UnderConstruction construction =
                EntityManager
                    .GetComponentData<UnderConstruction>(
                        m_TrackedBuilding
                    );

            float progress =
                math.saturate(
                    construction.m_Progress /
                    100f
                );

            float hiddenDistance =
                m_BuildingHeight +
                0.5f;

            float verticalOffset =
                -hiddenDistance *
                (1f - progress);

            Game.Objects.Transform proxyTransform =
                sourceTransform;

            proxyTransform.m_Position.y +=
                verticalOffset;

            EntityManager.SetComponentData(
                m_VisualProxy,
                proxyTransform
            );

            MarkProxyUpdated();

            if (
                construction.m_Progress !=
                m_LastProgress
            )
            {
                byte current =
                    construction.m_Progress;

                if (
                    current == 0 ||
                    current == 10 ||
                    current == 25 ||
                    current == 50 ||
                    current == 75 ||
                    current == 90 ||
                    current >= 98
                )
                {
                    int meshBatchCount =
                        EntityManager
                            .HasBuffer<MeshBatch>(
                                m_VisualProxy
                            )
                        ?
                        EntityManager
                            .GetBuffer<MeshBatch>(
                                m_VisualProxy
                            )
                            .Length
                        :
                        -1;

                    ModLog.Info(
                        $"V1.32 progress={current}% " +
                        $"offsetY={verticalOffset:0.00} m " +
                        $"MeshBatch={meshBatchCount}"
                    );
                }

                m_LastProgress =
                    current;
            }
        }

        private void MarkProxyUpdated()
        {
            if (
                m_VisualProxy == Entity.Null ||
                !EntityManager.Exists(
                    m_VisualProxy
                )
            )
            {
                return;
            }

            if (
                !EntityManager
                    .HasComponent<Updated>(
                        m_VisualProxy
                    )
            )
            {
                EntityManager
                    .AddComponent<Updated>(
                        m_VisualProxy
                    );
            }
        }

        // ============================================================
        // V1.32
        // SEARCH EVERY METHOD THAT REFERENCES:
        //
        // UnderConstruction.m_Progress
        // UnderConstruction.m_Speed
        // UnderConstruction.m_NewPrefab
        //
        // ============================================================

        private void RunUnderConstructionFieldScan()
        {
            if (m_FieldScanDone)
            {
                return;
            }

            m_FieldScanDone =
                true;

            try
            {
                Assembly gameAssembly =
                    typeof(UnderConstruction)
                        .Assembly;

                Type ucType =
                    typeof(UnderConstruction);

                FieldInfo progressField =
                    ucType.GetField(
                        "m_Progress",
                        BindingFlags.Instance |
                        BindingFlags.Public |
                        BindingFlags.NonPublic
                    );

                FieldInfo speedField =
                    ucType.GetField(
                        "m_Speed",
                        BindingFlags.Instance |
                        BindingFlags.Public |
                        BindingFlags.NonPublic
                    );

                FieldInfo newPrefabField =
                    ucType.GetField(
                        "m_NewPrefab",
                        BindingFlags.Instance |
                        BindingFlags.Public |
                        BindingFlags.NonPublic
                    );

                ModLog.Info(
                    "========== V1.32 FIELD REFERENCE SCAN BEGIN =========="
                );

                ModLog.Info(
                    $"V1.32 Game assembly = " +
                    $"{gameAssembly.FullName}"
                );

                LogTargetField(
                    "m_Progress",
                    progressField
                );

                LogTargetField(
                    "m_Speed",
                    speedField
                );

                LogTargetField(
                    "m_NewPrefab",
                    newPrefabField
                );

                Type[] types =
                    GetAssemblyTypesSafe(
                        gameAssembly
                    );

                int scannedMethods =
                    0;

                int progressMatches =
                    0;

                int speedMatches =
                    0;

                int newPrefabMatches =
                    0;

                for (
                    int typeIndex = 0;
                    typeIndex < types.Length;
                    typeIndex++
                )
                {
                    Type type =
                        types[typeIndex];

                    if (type == null)
                    {
                        continue;
                    }

                    MethodInfo[] methods;

                    try
                    {
                        methods =
                            type.GetMethods(
                                BindingFlags.Instance |
                                BindingFlags.Static |
                                BindingFlags.Public |
                                BindingFlags.NonPublic |
                                BindingFlags.DeclaredOnly
                            );
                    }
                    catch
                    {
                        continue;
                    }

                    for (
                        int methodIndex = 0;
                        methodIndex < methods.Length;
                        methodIndex++
                    )
                    {
                        MethodInfo method =
                            methods[methodIndex];

                        scannedMethods++;

                        bool usesProgress =
                            MethodReferencesField(
                                method,
                                progressField
                            );

                        bool usesSpeed =
                            MethodReferencesField(
                                method,
                                speedField
                            );

                        bool usesNewPrefab =
                            MethodReferencesField(
                                method,
                                newPrefabField
                            );

                        if (
                            !usesProgress &&
                            !usesSpeed &&
                            !usesNewPrefab
                        )
                        {
                            continue;
                        }

                        if (usesProgress)
                        {
                            progressMatches++;
                        }

                        if (usesSpeed)
                        {
                            speedMatches++;
                        }

                        if (usesNewPrefab)
                        {
                            newPrefabMatches++;
                        }

                        string flags =
                            "";

                        if (usesProgress)
                        {
                            flags +=
                                " PROGRESS";
                        }

                        if (usesSpeed)
                        {
                            flags +=
                                " SPEED";
                        }

                        if (usesNewPrefab)
                        {
                            flags +=
                                " NEW_PREFAB";
                        }

                        ModLog.Info(
                            "--------------------------------------------------"
                        );

                        ModLog.Info(
                            $"V1.32 FIELD USER:{flags} -> " +
                            $"{FormatMethod(method)}"
                        );

                        DumpRelevantMethodIL(
                            method,
                            progressField,
                            speedField,
                            newPrefabField
                        );
                    }
                }

                ModLog.Info(
                    "========== V1.32 FIELD REFERENCE SUMMARY =========="
                );

                ModLog.Info(
                    $"V1.32 methodsScanned=" +
                    $"{scannedMethods}"
                );

                ModLog.Info(
                    $"V1.32 progressMethodMatches=" +
                    $"{progressMatches}"
                );

                ModLog.Info(
                    $"V1.32 speedMethodMatches=" +
                    $"{speedMatches}"
                );

                ModLog.Info(
                    $"V1.32 newPrefabMethodMatches=" +
                    $"{newPrefabMatches}"
                );

                ModLog.Info(
                    "========== V1.32 FIELD REFERENCE SCAN END =========="
                );
            }
            catch (Exception ex)
            {
                ModLog.Error(
                    $"V1.32 field scan failed: {ex}"
                );
            }
        }

        private static void LogTargetField(
            string name,
            FieldInfo field
        )
        {
            if (field == null)
            {
                ModLog.Info(
                    $"V1.32 TARGET {name} = NOT FOUND"
                );

                return;
            }

            ModLog.Info(
                $"V1.32 TARGET {name}: " +
                $"token=0x{field.MetadataToken:X8}, " +
                $"type={field.FieldType.FullName}"
            );
        }

        private static Type[] GetAssemblyTypesSafe(
            Assembly assembly
        )
        {
            try
            {
                return assembly.GetTypes();
            }
            catch (
                ReflectionTypeLoadException ex
            )
            {
                List<Type> result =
                    new List<Type>();

                if (ex.Types != null)
                {
                    for (
                        int i = 0;
                        i < ex.Types.Length;
                        i++
                    )
                    {
                        if (
                            ex.Types[i] != null
                        )
                        {
                            result.Add(
                                ex.Types[i]
                            );
                        }
                    }
                }

                return result.ToArray();
            }
            catch
            {
                return Array.Empty<Type>();
            }
        }

        private bool MethodReferencesField(
            MethodInfo method,
            FieldInfo targetField
        )
        {
            if (
                method == null ||
                targetField == null
            )
            {
                return false;
            }

            MethodBody body;

            try
            {
                body =
                    method.GetMethodBody();
            }
            catch
            {
                return false;
            }

            if (body == null)
            {
                return false;
            }

            byte[] il;

            try
            {
                il =
                    body.GetILAsByteArray();
            }
            catch
            {
                return false;
            }

            if (
                il == null ||
                il.Length == 0
            )
            {
                return false;
            }

            int position =
                0;

            while (
                position <
                il.Length
            )
            {
                OpCode opcode =
                    ReadOpCode(
                        il,
                        ref position
                    );

                if (opcode.Size == 0)
                {
                    break;
                }

                if (
                    opcode.OperandType ==
                    OperandType.InlineField
                )
                {
                    if (
                        position + 4 >
                        il.Length
                    )
                    {
                        break;
                    }

                    int token =
                        BitConverter.ToInt32(
                            il,
                            position
                        );

                    position += 4;

                    FieldInfo field =
                        ResolveFieldSafe(
                            method,
                            token
                        );

                    if (
                        FieldsEqual(
                            field,
                            targetField
                        )
                    )
                    {
                        return true;
                    }

                    continue;
                }

                int operandSize =
                    GetOperandSize(
                        opcode.OperandType,
                        il,
                        position
                    );

                if (operandSize < 0)
                {
                    break;
                }

                position +=
                    operandSize;
            }

            return false;
        }

        private void DumpRelevantMethodIL(
            MethodInfo method,
            FieldInfo progressField,
            FieldInfo speedField,
            FieldInfo newPrefabField
        )
        {
            MethodBody body;

            try
            {
                body =
                    method.GetMethodBody();
            }
            catch
            {
                return;
            }

            if (body == null)
            {
                return;
            }

            byte[] il =
                body.GetILAsByteArray();

            if (
                il == null ||
                il.Length == 0
            )
            {
                return;
            }

            ModLog.Info(
                $"V1.32 IL BEGIN " +
                $"{method.DeclaringType?.FullName}." +
                $"{method.Name} " +
                $"bytes={il.Length}"
            );

            int position =
                0;

            int instructionCount =
                0;

            while (
                position < il.Length &&
                instructionCount < 5000
            )
            {
                int offset =
                    position;

                OpCode opcode =
                    ReadOpCode(
                        il,
                        ref position
                    );

                if (opcode.Size == 0)
                {
                    break;
                }

                string operandText =
                    "";

                bool important =
                    false;

                try
                {
                    if (
                        opcode.OperandType ==
                        OperandType.InlineField
                    )
                    {
                        int token =
                            BitConverter.ToInt32(
                                il,
                                position
                            );

                        position += 4;

                        FieldInfo field =
                            ResolveFieldSafe(
                                method,
                                token
                            );

                        if (field != null)
                        {
                            operandText =
                                $"FIELD " +
                                $"{field.DeclaringType?.FullName}." +
                                $"{field.Name}:" +
                                $"{FormatType(field.FieldType)}";

                            if (
                                FieldsEqual(
                                    field,
                                    progressField
                                ) ||
                                FieldsEqual(
                                    field,
                                    speedField
                                ) ||
                                FieldsEqual(
                                    field,
                                    newPrefabField
                                )
                            )
                            {
                                important =
                                    true;
                            }
                        }
                        else
                        {
                            operandText =
                                $"FIELD token=0x{token:X8}";
                        }
                    }
                    else if (
                        opcode.OperandType ==
                        OperandType.InlineMethod ||
                        opcode.OperandType ==
                        OperandType.InlineType ||
                        opcode.OperandType ==
                        OperandType.InlineTok
                    )
                    {
                        int token =
                            BitConverter.ToInt32(
                                il,
                                position
                            );

                        position += 4;

                        operandText =
                            ResolveMemberText(
                                method,
                                token
                            );
                    }
                    else
                    {
                        operandText =
                            ReadSimpleOperand(
                                opcode,
                                il,
                                ref position
                            );
                    }
                }
                catch (Exception ex)
                {
                    operandText =
                        $"<ERROR " +
                        $"{ex.GetType().Name}>";
                }

                if (
                    important ||
                    opcode.FlowControl ==
                        FlowControl.Call ||
                    opcode.Name.StartsWith(
                        "br",
                        StringComparison.Ordinal
                    ) ||
                    opcode.Name == "ret"
                )
                {
                    ModLog.Info(
                        $"V1.32 IL {offset:X4}: " +
                        $"{opcode.Name} " +
                        $"{operandText}"
                    );
                }

                instructionCount++;
            }

            ModLog.Info(
                $"V1.32 IL END " +
                $"{method.DeclaringType?.FullName}." +
                $"{method.Name}"
            );
        }

        private static FieldInfo ResolveFieldSafe(
            MethodInfo context,
            int token
        )
        {
            try
            {
                Type[] typeArgs =
                    context.DeclaringType != null &&
                    context.DeclaringType.IsGenericType
                    ?
                    context.DeclaringType
                        .GetGenericArguments()
                    :
                    null;

                Type[] methodArgs =
                    context.IsGenericMethod
                    ?
                    context
                        .GetGenericArguments()
                    :
                    null;

                return context.Module.ResolveField(
                    token,
                    typeArgs,
                    methodArgs
                );
            }
            catch
            {
                return null;
            }
        }

        private static bool FieldsEqual(
            FieldInfo a,
            FieldInfo b
        )
        {
            if (
                a == null ||
                b == null
            )
            {
                return false;
            }

            try
            {
                return
                    a.MetadataToken ==
                        b.MetadataToken &&
                    a.Module ==
                        b.Module;
            }
            catch
            {
                return false;
            }
        }

        private string ResolveMemberText(
            MethodInfo context,
            int token
        )
        {
            try
            {
                Type[] typeArgs =
                    context.DeclaringType != null &&
                    context.DeclaringType.IsGenericType
                    ?
                    context.DeclaringType
                        .GetGenericArguments()
                    :
                    null;

                Type[] methodArgs =
                    context.IsGenericMethod
                    ?
                    context
                        .GetGenericArguments()
                    :
                    null;

                MemberInfo member =
                    context.Module.ResolveMember(
                        token,
                        typeArgs,
                        methodArgs
                    );

                if (
                    member is MethodBase method
                )
                {
                    return
                        $"METHOD " +
                        $"{FormatMethod(method)}";
                }

                if (
                    member is Type type
                )
                {
                    return
                        $"TYPE " +
                        $"{type.FullName}";
                }

                if (
                    member is FieldInfo field
                )
                {
                    return
                        $"FIELD " +
                        $"{field.DeclaringType?.FullName}." +
                        $"{field.Name}";
                }

                if (member != null)
                {
                    return
                        $"{member.DeclaringType?.FullName}." +
                        $"{member.Name}";
                }
            }
            catch
            {
            }

            return
                $"TOKEN 0x{token:X8}";
        }

        private string ReadSimpleOperand(
            OpCode opcode,
            byte[] il,
            ref int position
        )
        {
            switch (
                opcode.OperandType
            )
            {
                case OperandType.InlineNone:
                    return "";

                case OperandType.ShortInlineI:
                    {
                        sbyte value =
                            unchecked(
                                (sbyte)il[position]
                            );

                        position++;

                        return value.ToString();
                    }

                case OperandType.InlineI:
                    {
                        int value =
                            BitConverter.ToInt32(
                                il,
                                position
                            );

                        position += 4;

                        return value.ToString();
                    }

                case OperandType.InlineI8:
                    {
                        long value =
                            BitConverter.ToInt64(
                                il,
                                position
                            );

                        position += 8;

                        return value.ToString();
                    }

                case OperandType.ShortInlineR:
                    {
                        float value =
                            BitConverter.ToSingle(
                                il,
                                position
                            );

                        position += 4;

                        return value.ToString(
                            "R"
                        );
                    }

                case OperandType.InlineR:
                    {
                        double value =
                            BitConverter.ToDouble(
                                il,
                                position
                            );

                        position += 8;

                        return value.ToString(
                            "R"
                        );
                    }

                case OperandType.ShortInlineVar:
                    {
                        byte value =
                            il[position++];

                        return value.ToString();
                    }

                case OperandType.InlineVar:
                    {
                        ushort value =
                            BitConverter.ToUInt16(
                                il,
                                position
                            );

                        position += 2;

                        return value.ToString();
                    }

                case OperandType.ShortInlineBrTarget:
                    {
                        sbyte delta =
                            unchecked(
                                (sbyte)il[position]
                            );

                        position++;

                        return
                            $"IL_{position + delta:X4}";
                    }

                case OperandType.InlineBrTarget:
                    {
                        int delta =
                            BitConverter.ToInt32(
                                il,
                                position
                            );

                        position += 4;

                        return
                            $"IL_{position + delta:X4}";
                    }

                case OperandType.InlineString:
                    {
                        int token =
                            BitConverter.ToInt32(
                                il,
                                position
                            );

                        position += 4;

                        return
                            $"STRING 0x{token:X8}";
                    }

                case OperandType.InlineSig:
                    {
                        int token =
                            BitConverter.ToInt32(
                                il,
                                position
                            );

                        position += 4;

                        return
                            $"SIG 0x{token:X8}";
                    }

                case OperandType.InlineSwitch:
                    {
                        int count =
                            BitConverter.ToInt32(
                                il,
                                position
                            );

                        position += 4;

                        int basePosition =
                            position +
                            count * 4;

                        string result =
                            "[";

                        for (
                            int i = 0;
                            i < count;
                            i++
                        )
                        {
                            int delta =
                                BitConverter.ToInt32(
                                    il,
                                    position
                                );

                            position += 4;

                            if (i > 0)
                            {
                                result += ", ";
                            }

                            result +=
                                $"IL_{basePosition + delta:X4}";
                        }

                        result += "]";

                        return result;
                    }

                default:
                    {
                        int size =
                            GetOperandSize(
                                opcode.OperandType,
                                il,
                                position
                            );

                        if (size > 0)
                        {
                            position +=
                                size;
                        }

                        return
                            $"<{opcode.OperandType}>";
                    }
            }
        }

        // ============================================================
        // IL HELPERS
        // ============================================================

        private static Dictionary<short, OpCode>
            BuildOpCodeMap()
        {
            Dictionary<short, OpCode> result =
                new Dictionary<short, OpCode>();

            FieldInfo[] fields =
                typeof(OpCodes)
                    .GetFields(
                        BindingFlags.Public |
                        BindingFlags.Static
                    );

            for (
                int i = 0;
                i < fields.Length;
                i++
            )
            {
                FieldInfo field =
                    fields[i];

                if (
                    field.FieldType !=
                    typeof(OpCode)
                )
                {
                    continue;
                }

                try
                {
                    OpCode opcode =
                        (OpCode)field
                            .GetValue(null);

                    result[opcode.Value] =
                        opcode;
                }
                catch
                {
                }
            }

            return result;
        }

        private static OpCode ReadOpCode(
            byte[] il,
            ref int position
        )
        {
            if (
                position >=
                il.Length
            )
            {
                return default(OpCode);
            }

            byte first =
                il[position++];

            short value;

            if (first == 0xFE)
            {
                if (
                    position >=
                    il.Length
                )
                {
                    return default(OpCode);
                }

                byte second =
                    il[position++];

                value =
                    unchecked(
                        (short)(
                            0xFE00 |
                            second
                        )
                    );
            }
            else
            {
                value =
                    first;
            }

            if (
                s_OpCodes.TryGetValue(
                    value,
                    out OpCode opcode
                )
            )
            {
                return opcode;
            }

            return default(OpCode);
        }

        private static int GetOperandSize(
            OperandType operandType,
            byte[] il,
            int position
        )
        {
            switch (
                operandType
            )
            {
                case OperandType.InlineNone:
                    return 0;

                case OperandType.ShortInlineBrTarget:
                case OperandType.ShortInlineI:
                case OperandType.ShortInlineVar:
                    return 1;

                case OperandType.InlineVar:
                    return 2;

                case OperandType.InlineBrTarget:
                case OperandType.InlineField:
                case OperandType.InlineI:
                case OperandType.InlineMethod:
                case OperandType.InlineSig:
                case OperandType.InlineString:
                case OperandType.InlineTok:
                case OperandType.InlineType:
                case OperandType.ShortInlineR:
                    return 4;

                case OperandType.InlineI8:
                case OperandType.InlineR:
                    return 8;

                case OperandType.InlineSwitch:
                    {
                        if (
                            position + 4 >
                            il.Length
                        )
                        {
                            return -1;
                        }

                        int count =
                            BitConverter.ToInt32(
                                il,
                                position
                            );

                        if (count < 0)
                        {
                            return -1;
                        }

                        return
                            4 +
                            count * 4;
                    }

                default:
                    return -1;
            }
        }

        // ============================================================
        // FORMATTERS
        // ============================================================

        private static string FormatMethod(
            MethodBase method
        )
        {
            if (method == null)
            {
                return "<null>";
            }

            string args =
                "";

            try
            {
                ParameterInfo[] parameters =
                    method.GetParameters();

                for (
                    int i = 0;
                    i < parameters.Length;
                    i++
                )
                {
                    if (i > 0)
                    {
                        args += ", ";
                    }

                    args +=
                        FormatType(
                            parameters[i]
                                .ParameterType
                        );
                }
            }
            catch
            {
            }

            string returnType =
                "void";

            if (
                method is MethodInfo info
            )
            {
                returnType =
                    FormatType(
                        info.ReturnType
                    );
            }

            return
                $"{returnType} " +
                $"{method.DeclaringType?.FullName}." +
                $"{method.Name}(" +
                $"{args})";
        }

        private static string FormatType(
            Type type
        )
        {
            if (type == null)
            {
                return "<null>";
            }

            if (type.IsByRef)
            {
                return
                    FormatType(
                        type.GetElementType()
                    ) +
                    "&";
            }

            if (type.IsArray)
            {
                return
                    FormatType(
                        type.GetElementType()
                    ) +
                    "[]";
            }

            return
                type.FullName ??
                type.Name;
        }

        // ============================================================
        // ECS VISUAL COPY
        // ============================================================

        private void CopyVisualComponent<T>(
            Entity source
        )
            where T : unmanaged,
            IComponentData
        {
            if (
                !EntityManager
                    .HasComponent<T>(
                        source
                    )
            )
            {
                return;
            }

            T value =
                EntityManager
                    .GetComponentData<T>(
                        source
                    );

            if (
                EntityManager
                    .HasComponent<T>(
                        m_VisualProxy
                    )
            )
            {
                EntityManager
                    .SetComponentData(
                        m_VisualProxy,
                        value
                    );
            }
            else
            {
                EntityManager
                    .AddComponentData(
                        m_VisualProxy,
                        value
                    );
            }
        }

        private void CopyMeshColorBuffer(
            Entity source
        )
        {
            if (
                !EntityManager
                    .HasBuffer<MeshColor>(
                        m_VisualProxy
                    )
            )
            {
                EntityManager
                    .AddBuffer<MeshColor>(
                        m_VisualProxy
                    );
            }

            DynamicBuffer<MeshColor> target =
                EntityManager
                    .GetBuffer<MeshColor>(
                        m_VisualProxy
                    );

            target.Clear();

            if (
                !EntityManager
                    .HasBuffer<MeshColor>(
                        source
                    )
            )
            {
                return;
            }

            DynamicBuffer<MeshColor> sourceBuffer =
                EntityManager
                    .GetBuffer<MeshColor>(
                        source
                    );

            for (
                int i = 0;
                i < sourceBuffer.Length;
                i++
            )
            {
                target.Add(
                    sourceBuffer[i]
                );
            }
        }

        private void CopyCustomMeshColorBuffer(
            Entity source
        )
        {
            if (
                !EntityManager
                    .HasBuffer<CustomMeshColor>(
                        m_VisualProxy
                    )
            )
            {
                EntityManager
                    .AddBuffer<CustomMeshColor>(
                        m_VisualProxy
                    );
            }

            DynamicBuffer<CustomMeshColor> target =
                EntityManager
                    .GetBuffer<CustomMeshColor>(
                        m_VisualProxy
                    );

            target.Clear();

            if (
                !EntityManager
                    .HasBuffer<CustomMeshColor>(
                        source
                    )
            )
            {
                return;
            }

            DynamicBuffer<CustomMeshColor> sourceBuffer =
                EntityManager
                    .GetBuffer<CustomMeshColor>(
                        source
                    );

            for (
                int i = 0;
                i < sourceBuffer.Length;
                i++
            )
            {
                target.Add(
                    sourceBuffer[i]
                );
            }
        }

        // ============================================================
        // CLEANUP
        // ============================================================

        private void DestroyNativeProxy()
        {
            if (
                m_VisualProxy != Entity.Null &&
                EntityManager.Exists(
                    m_VisualProxy
                )
            )
            {
                try
                {
                    EntityManager
                        .DestroyEntity(
                            m_VisualProxy
                        );
                }
                catch
                {
                }
            }

            m_VisualProxy =
                Entity.Null;
        }

        private void DestroyEverything()
        {
            DestroyNativeProxy();

            m_TrackedBuilding =
                Entity.Null;

            m_LastProgress =
                255;
        }

        protected override void OnDestroy()
        {
            DestroyEverything();

            base.OnDestroy();
        }
    }
}