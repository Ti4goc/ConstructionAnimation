using Colossal.IO.AssetDatabase;
using Game;
using Game.Buildings;
using Game.Common;
using Game.Objects;
using Game.Prefabs;
using Game.Rendering;
using System;
using System.Collections.Generic;
using System.Reflection;
using Unity.Collections;
using Unity.Entities;
using Unity.Mathematics;
using UnityEngine;

namespace ConstructionAnimation.Systems
{
    public partial class ConstructionDetectionSystem : GameSystemBase
    {
        // ============================================================
        // QUERY / PREFABS
        // ============================================================

        private EntityQuery m_BuildingQuery;
        private PrefabSystem m_PrefabSystem;

        // ============================================================
        // ONE VISUAL STATE PER BUILDING
        // ============================================================

        private sealed class ConstructionVisual
        {
            public Entity Source = Entity.Null;
            public Entity Proxy = Entity.Null;

            public float BuildingHeight = 20f;

            public float3 BuildingSize =
                new float3(20f, 20f, 20f);

            public float3 GeometryPivot =
                float3.zero;

            public List<Vector2> Footprint =
                new List<Vector2>();

            public GameObject ScaffoldRoot;

            public List<GameObject> ScaffoldLevels =
                new List<GameObject>();

            public float ScaffoldHeight;
            public int ScaffoldLevelCount;

            public byte LastProgress = 255;

            public bool SeenThisFrame;
        }

        private sealed class PendingProxyDestroy
        {
            public Entity Entity = Entity.Null;
            public int Frames;
        }

        private readonly Dictionary<Entity, ConstructionVisual>
            m_Visuals =
                new Dictionary<Entity, ConstructionVisual>();

        private readonly List<Entity>
            m_RemoveSources =
                new List<Entity>();

        private readonly List<PendingProxyDestroy>
            m_PendingProxyDestroys =
                new List<PendingProxyDestroy>();

        // ============================================================
        // MATERIALS
        // ============================================================

        private Material m_ScaffoldMetalMaterial;
        private Material m_ScaffoldDeckMaterial;

        // ============================================================
        // CONSTANTS
        // ============================================================

        private const int ProxyDestroyDelayFrames = 4;

        // Distance between facade and outside scaffold frame.
        private const float ScaffoldMargin = 1.10f;

        // Approximate floor/module height.
        private const float ScaffoldFloorHeight = 3.0f;

        // Maximum horizontal spacing between posts.
        private const float ScaffoldBayWidth = 3.0f;

        private const float ScaffoldBeamThickness = 0.10f;

        // Wooden walkway depth.
        private const float ScaffoldDeckDepth = 0.85f;

        private const float ScaffoldDeckThickness = 0.12f;

        // Keep the scaffold a tiny bit above the terrain.
        private const float ScaffoldGroundOffset = 0.05f;

        // Scaffold reaches its maximum level around 80%.
        private const float ScaffoldRiseEnd = 0.80f;

        // ============================================================
        // CREATE
        // ============================================================

        protected override void OnCreate()
        {
            base.OnCreate();

            m_PrefabSystem =
                World.GetOrCreateSystemManaged<PrefabSystem>();

            m_BuildingQuery =
                GetEntityQuery(
                    ComponentType.ReadOnly<UnderConstruction>(),
                    ComponentType.ReadOnly<Building>(),
                    ComponentType.ReadOnly<PrefabRef>(),
                    ComponentType.ReadOnly<Game.Objects.Transform>()
                );

            CreateScaffoldMaterials();

            ModLog.Info(
                "ConstructionAnimation V1.35 shape-following multi-level scaffold created."
            );
        }

        // ============================================================
        // UPDATE
        // ============================================================

        protected override void OnUpdate()
        {
            ProcessPendingProxyDestroys();

            foreach (
                ConstructionVisual visual
                in m_Visuals.Values
            )
            {
                visual.SeenThisFrame =
                    false;
            }

            using NativeArray<Entity> buildings =
                m_BuildingQuery.ToEntityArray(
                    Allocator.Temp
                );

            for (
                int i = 0;
                i < buildings.Length;
                i++
            )
            {
                Entity source =
                    buildings[i];

                if (
                    source == Entity.Null ||
                    !EntityManager.Exists(source)
                )
                {
                    continue;
                }

                ConstructionVisual visual;

                if (
                    !m_Visuals.TryGetValue(
                        source,
                        out visual
                    )
                )
                {
                    visual =
                        CreateConstructionVisual(
                            source
                        );

                    if (visual == null)
                        continue;

                    m_Visuals.Add(
                        source,
                        visual
                    );
                }

                visual.SeenThisFrame =
                    true;

                UpdateConstructionVisual(
                    visual
                );
            }

            // --------------------------------------------------------
            // Remove constructions that have completed/disappeared.
            // --------------------------------------------------------

            m_RemoveSources.Clear();

            foreach (
                KeyValuePair<Entity, ConstructionVisual> pair
                in m_Visuals
            )
            {
                if (
                    !pair.Value.SeenThisFrame
                )
                {
                    m_RemoveSources.Add(
                        pair.Key
                    );
                }
            }

            for (
                int i = 0;
                i < m_RemoveSources.Count;
                i++
            )
            {
                Entity source =
                    m_RemoveSources[i];

                ConstructionVisual visual;

                if (
                    !m_Visuals.TryGetValue(
                        source,
                        out visual
                    )
                )
                {
                    continue;
                }

                DestroyConstructionVisual(
                    visual
                );

                m_Visuals.Remove(
                    source
                );
            }
        }

        // ============================================================
        // CREATE VISUAL
        // ============================================================

        private ConstructionVisual CreateConstructionVisual(
            Entity source
        )
        {
            try
            {
                ConstructionVisual visual =
                    new ConstructionVisual();

                visual.Source =
                    source;

                PrefabRef prefabRef =
                    EntityManager.GetComponentData<PrefabRef>(
                        source
                    );

                ReadBuildingGeometry(
                    prefabRef.m_Prefab,
                    visual
                );

                // ----------------------------------------------------
                // V1.35:
                // Attempt to obtain actual building footprint.
                // ----------------------------------------------------

                visual.Footprint =
                    ExtractBuildingFootprint(
                        prefabRef.m_Prefab,
                        visual
                    );

                CreateNativeProxy(
                    visual,
                    prefabRef
                );

                CreateScaffold(
                    visual
                );

                UnderConstruction construction =
                    EntityManager.GetComponentData<UnderConstruction>(
                        source
                    );

                ModLog.Info(
                    $"V1.35 construction added " +
                    $"{source.Index}:{source.Version}, " +
                    $"progress={construction.m_Progress}%, " +
                    $"footprintPoints={visual.Footprint.Count}, " +
                    $"levels={visual.ScaffoldLevelCount}"
                );

                return visual;
            }
            catch (Exception ex)
            {
                ModLog.Error(
                    $"V1.35 CreateConstructionVisual failed " +
                    $"for {source.Index}:{source.Version}: {ex}"
                );

                return null;
            }
        }

        // ============================================================
        // BASIC BUILDING GEOMETRY
        // ============================================================

        private void ReadBuildingGeometry(
            Entity prefab,
            ConstructionVisual visual
        )
        {
            visual.BuildingHeight =
                20f;

            visual.BuildingSize =
                new float3(
                    20f,
                    20f,
                    20f
                );

            visual.GeometryPivot =
                float3.zero;

            try
            {
                if (
                    !EntityManager.HasComponent<ObjectGeometryData>(
                        prefab
                    )
                )
                {
                    return;
                }

                ObjectGeometryData geometry =
                    EntityManager.GetComponentData<ObjectGeometryData>(
                        prefab
                    );

                visual.BuildingSize =
                    geometry.m_Size;

                visual.GeometryPivot =
                    geometry.m_Pivot;

                if (
                    geometry.m_Size.y > 0.5f &&
                    geometry.m_Size.y < 1000f
                )
                {
                    visual.BuildingHeight =
                        geometry.m_Size.y;
                }
            }
            catch (Exception ex)
            {
                ModLog.Info(
                    $"V1.35 geometry read failed: " +
                    $"{ex.GetType().Name}"
                );
            }
        }

        // ============================================================
        // V1.35
        // EXTRACT REAL BUILDING FOOTPRINT
        // ============================================================

        private List<Vector2> ExtractBuildingFootprint(
            Entity buildingPrefab,
            ConstructionVisual visual
        )
        {
            List<Vector2> points =
                new List<Vector2>();

            try
            {
                if (
                    !EntityManager.HasBuffer<SubMesh>(
                        buildingPrefab
                    )
                )
                {
                    return CreateFallbackFootprint(
                        visual
                    );
                }

                DynamicBuffer<SubMesh> subMeshes =
                    EntityManager.GetBuffer<SubMesh>(
                        buildingPrefab
                    );

                for (
                    int subIndex = 0;
                    subIndex < subMeshes.Length;
                    subIndex++
                )
                {
                    SubMesh subMesh =
                        subMeshes[subIndex];

                    Entity renderPrefabEntity =
                        subMesh.m_SubMesh;

                    if (
                        renderPrefabEntity == Entity.Null ||
                        !EntityManager.Exists(
                            renderPrefabEntity
                        )
                    )
                    {
                        continue;
                    }

                    PrefabBase managedPrefab;

                    try
                    {
                        managedPrefab =
                            m_PrefabSystem.GetPrefab<PrefabBase>(
                                renderPrefabEntity
                            );
                    }
                    catch
                    {
                        continue;
                    }

                    if (
                        managedPrefab == null
                    )
                    {
                        continue;
                    }

                    GeometryAsset geometryAsset =
                        GetGeometryAsset(
                            managedPrefab
                        );

                    if (
                        geometryAsset == null
                    )
                    {
                        continue;
                    }

                    Mesh[] meshes =
                        null;

                    try
                    {
                        meshes =
                            geometryAsset.ObtainMeshes(
                                true
                            );

                        if (
                            meshes == null ||
                            meshes.Length == 0
                        )
                        {
                            continue;
                        }

                        // ------------------------------------------------
                        // Usually mesh 0 is the main solid building mesh.
                        //
                        // Glass/window meshes would only duplicate the same
                        // projected contour and add a lot of vertices.
                        // ------------------------------------------------

                        Mesh mainMesh =
                            meshes[0];

                        if (
                            mainMesh == null
                        )
                        {
                            continue;
                        }

                        Vector3[] vertices =
                            mainMesh.vertices;

                        for (
                            int vertexIndex = 0;
                            vertexIndex < vertices.Length;
                            vertexIndex++
                        )
                        {
                            Vector3 vertex =
                                vertices[vertexIndex];

                            float3 local =
                                new float3(
                                    vertex.x,
                                    vertex.y,
                                    vertex.z
                                );

                            local =
                                math.rotate(
                                    subMesh.m_Rotation,
                                    local
                                );

                            local +=
                                subMesh.m_Position;

                            points.Add(
                                new Vector2(
                                    local.x,
                                    local.z
                                )
                            );
                        }
                    }
                    catch (Exception ex)
                    {
                        ModLog.Info(
                            $"V1.35 mesh footprint extraction failed: " +
                            $"{ex.GetType().Name}"
                        );
                    }
                    finally
                    {
                        try
                        {
                            geometryAsset.ReleaseMeshes();
                        }
                        catch
                        {
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                ModLog.Info(
                    $"V1.35 footprint extraction failed: " +
                    $"{ex.GetType().Name}"
                );
            }

            if (
                points.Count < 3
            )
            {
                ModLog.Info(
                    "V1.35 footprint fallback: insufficient mesh points."
                );

                return CreateFallbackFootprint(
                    visual
                );
            }

            // --------------------------------------------------------
            // Reduce thousands of vertices to the external silhouette.
            // --------------------------------------------------------

            List<Vector2> hull =
                CalculateConvexHull(
                    points
                );

            if (
                hull.Count < 3
            )
            {
                ModLog.Info(
                    "V1.35 footprint fallback: hull failed."
                );

                return CreateFallbackFootprint(
                    visual
                );
            }

            // --------------------------------------------------------
            // Remove almost-collinear points to avoid tiny scaffold bays.
            // --------------------------------------------------------

            hull =
                SimplifyHull(
                    hull
                );

            ModLog.Info(
                $"V1.35 footprint: " +
                $"vertices={points.Count}, " +
                $"hull={hull.Count}"
            );

            return hull;
        }

        // ============================================================
        // GEOMETRY ASSET REFLECTION
        // ============================================================

        private GeometryAsset GetGeometryAsset(
            object renderPrefab
        )
        {
            if (
                renderPrefab == null
            )
            {
                return null;
            }

            try
            {
                FieldInfo field =
                    renderPrefab
                        .GetType()
                        .GetField(
                            "m_GeometryAsset",
                            BindingFlags.Instance |
                            BindingFlags.Public |
                            BindingFlags.NonPublic
                        );

                if (
                    field == null
                )
                {
                    return null;
                }

                object reference =
                    field.GetValue(
                        renderPrefab
                    );

                return ConvertAssetReference<GeometryAsset>(
                    reference
                );
            }
            catch
            {
                return null;
            }
        }

        private static T ConvertAssetReference<T>(
            object assetReference
        )
            where T : class
        {
            if (
                assetReference == null
            )
            {
                return null;
            }

            try
            {
                Type referenceType =
                    assetReference.GetType();

                MethodInfo[] methods =
                    referenceType.GetMethods(
                        BindingFlags.Static |
                        BindingFlags.Public |
                        BindingFlags.NonPublic
                    );

                foreach (
                    MethodInfo method
                    in methods
                )
                {
                    if (
                        method.Name != "op_Implicit" ||
                        !typeof(T).IsAssignableFrom(
                            method.ReturnType
                        )
                    )
                    {
                        continue;
                    }

                    ParameterInfo[] parameters =
                        method.GetParameters();

                    if (
                        parameters.Length != 1
                    )
                    {
                        continue;
                    }

                    object result =
                        method.Invoke(
                            null,
                            new object[]
                            {
                                assetReference
                            }
                        );

                    return result as T;
                }
            }
            catch
            {
            }

            return null;
        }

        // ============================================================
        // FALLBACK RECTANGLE
        // ============================================================

        private List<Vector2> CreateFallbackFootprint(
            ConstructionVisual visual
        )
        {
            float halfWidth =
                visual.BuildingSize.x *
                0.5f;

            float halfDepth =
                visual.BuildingSize.z *
                0.5f;

            return new List<Vector2>
            {
                new Vector2(
                    -halfWidth,
                    -halfDepth
                ),

                new Vector2(
                    halfWidth,
                    -halfDepth
                ),

                new Vector2(
                    halfWidth,
                    halfDepth
                ),

                new Vector2(
                    -halfWidth,
                    halfDepth
                )
            };
        }

        // ============================================================
        // CONVEX HULL
        // ============================================================

        private static List<Vector2> CalculateConvexHull(
            List<Vector2> input
        )
        {
            List<Vector2> points =
                new List<Vector2>(
                    input
                );

            points.Sort(
                delegate (
                    Vector2 a,
                    Vector2 b
                )
                {
                    int xCompare =
                        a.x.CompareTo(
                            b.x
                        );

                    if (
                        xCompare != 0
                    )
                    {
                        return xCompare;
                    }

                    return a.y.CompareTo(
                        b.y
                    );
                }
            );

            List<Vector2> unique =
                new List<Vector2>();

            for (
                int i = 0;
                i < points.Count;
                i++
            )
            {
                if (
                    unique.Count == 0 ||
                    Vector2.SqrMagnitude(
                        points[i] -
                        unique[
                            unique.Count - 1
                        ]
                    ) >
                    0.0025f
                )
                {
                    unique.Add(
                        points[i]
                    );
                }
            }

            if (
                unique.Count <= 3
            )
            {
                return unique;
            }

            List<Vector2> lower =
                new List<Vector2>();

            for (
                int i = 0;
                i < unique.Count;
                i++
            )
            {
                Vector2 point =
                    unique[i];

                while (
                    lower.Count >= 2 &&
                    Cross(
                        lower[
                            lower.Count - 2
                        ],
                        lower[
                            lower.Count - 1
                        ],
                        point
                    ) <= 0f
                )
                {
                    lower.RemoveAt(
                        lower.Count - 1
                    );
                }

                lower.Add(
                    point
                );
            }

            List<Vector2> upper =
                new List<Vector2>();

            for (
                int i =
                    unique.Count - 1;
                i >= 0;
                i--
            )
            {
                Vector2 point =
                    unique[i];

                while (
                    upper.Count >= 2 &&
                    Cross(
                        upper[
                            upper.Count - 2
                        ],
                        upper[
                            upper.Count - 1
                        ],
                        point
                    ) <= 0f
                )
                {
                    upper.RemoveAt(
                        upper.Count - 1
                    );
                }

                upper.Add(
                    point
                );
            }

            lower.RemoveAt(
                lower.Count - 1
            );

            upper.RemoveAt(
                upper.Count - 1
            );

            lower.AddRange(
                upper
            );

            return lower;
        }

        private static float Cross(
            Vector2 a,
            Vector2 b,
            Vector2 c
        )
        {
            return
                (
                    b.x -
                    a.x
                ) *
                (
                    c.y -
                    a.y
                ) -
                (
                    b.y -
                    a.y
                ) *
                (
                    c.x -
                    a.x
                );
        }

        // ============================================================
        // SIMPLIFY HULL
        // ============================================================

        private static List<Vector2> SimplifyHull(
            List<Vector2> hull
        )
        {
            if (
                hull.Count <= 4
            )
            {
                return hull;
            }

            List<Vector2> result =
                new List<Vector2>();

            const float minEdgeLength =
                0.75f;

            const float straightThreshold =
                0.985f;

            for (
                int i = 0;
                i < hull.Count;
                i++
            )
            {
                Vector2 previous =
                    hull[
                        (
                            i -
                            1 +
                            hull.Count
                        ) %
                        hull.Count
                    ];

                Vector2 current =
                    hull[i];

                Vector2 next =
                    hull[
                        (
                            i +
                            1
                        ) %
                        hull.Count
                    ];

                Vector2 a =
                    (
                        current -
                        previous
                    );

                Vector2 b =
                    (
                        next -
                        current
                    );

                if (
                    a.magnitude <
                    minEdgeLength
                )
                {
                    continue;
                }

                if (
                    a.sqrMagnitude >
                    0.001f &&
                    b.sqrMagnitude >
                    0.001f
                )
                {
                    float dot =
                        Vector2.Dot(
                            a.normalized,
                            b.normalized
                        );

                    if (
                        dot >
                        straightThreshold
                    )
                    {
                        continue;
                    }
                }

                result.Add(
                    current
                );
            }

            if (
                result.Count < 3
            )
            {
                return hull;
            }

            return result;
        }

        // ============================================================
        // OFFSET BUILDING OUTLINE
        // ============================================================

        private List<Vector2> CreateScaffoldOutline(
            List<Vector2> footprint
        )
        {
            List<Vector2> result =
                new List<Vector2>();

            if (
                footprint == null ||
                footprint.Count < 3
            )
            {
                return result;
            }

            for (
                int i = 0;
                i < footprint.Count;
                i++
            )
            {
                Vector2 previous =
                    footprint[
                        (
                            i -
                            1 +
                            footprint.Count
                        ) %
                        footprint.Count
                    ];

                Vector2 current =
                    footprint[i];

                Vector2 next =
                    footprint[
                        (
                            i +
                            1
                        ) %
                        footprint.Count
                    ];

                Vector2 incoming =
                    (
                        current -
                        previous
                    ).normalized;

                Vector2 outgoing =
                    (
                        next -
                        current
                    ).normalized;

                // Hull is CCW.
                // Right-hand normal points outside.

                Vector2 normalA =
                    new Vector2(
                        incoming.y,
                        -incoming.x
                    );

                Vector2 normalB =
                    new Vector2(
                        outgoing.y,
                        -outgoing.x
                    );

                Vector2 combined =
                    normalA +
                    normalB;

                if (
                    combined.sqrMagnitude <
                    0.001f
                )
                {
                    combined =
                        normalB;
                }

                combined.Normalize();

                float denominator =
                    Mathf.Max(
                        0.35f,
                        Vector2.Dot(
                            combined,
                            normalB
                        )
                    );

                float offset =
                    ScaffoldMargin /
                    denominator;

                // Avoid enormous spikes on acute corners.
                offset =
                    Mathf.Min(
                        offset,
                        ScaffoldMargin *
                        2.2f
                    );

                result.Add(
                    current +
                    combined *
                    offset
                );
            }

            return result;
        }

        // ============================================================
        // NATIVE BUILDING PROXY
        // ============================================================

        private void CreateNativeProxy(
            ConstructionVisual visual,
            PrefabRef prefabRef
        )
        {
            Entity source =
                visual.Source;

            Game.Objects.Transform transform =
                EntityManager.GetComponentData<
                    Game.Objects.Transform
                >(
                    source
                );

            EntityArchetype archetype =
                EntityManager.CreateArchetype(
                    typeof(PrefabRef),
                    typeof(Game.Objects.Transform),
                    typeof(Game.Objects.Object),
                    typeof(Game.Objects.ObjectGeometry),
                    typeof(Game.Objects.Static),
                    typeof(Created),
                    typeof(Updated),
                    typeof(Unity.Entities.Simulate)
                );

            Entity proxy =
                EntityManager.CreateEntity(
                    archetype
                );

            visual.Proxy =
                proxy;

            EntityManager.SetComponentData(
                proxy,
                prefabRef
            );

            EntityManager.SetComponentData(
                proxy,
                transform
            );

            CopyVisualComponent<CullingInfo>(
                source,
                proxy
            );

            CopyVisualComponent<Game.Objects.Color>(
                source,
                proxy
            );

            CopyVisualComponent<Game.Objects.Surface>(
                source,
                proxy
            );

            CopyVisualComponent<PseudoRandomSeed>(
                source,
                proxy
            );

            CopyMeshColorBuffer(
                source,
                proxy
            );

            CopyCustomMeshColorBuffer(
                source,
                proxy
            );

            if (
                !EntityManager.HasBuffer<MeshBatch>(
                    proxy
                )
            )
            {
                EntityManager.AddBuffer<MeshBatch>(
                    proxy
                );
            }
        }

        // ============================================================
        // UPDATE CONSTRUCTION
        // ============================================================

        private void UpdateConstructionVisual(
            ConstructionVisual visual
        )
        {
            if (
                visual == null ||
                visual.Source == Entity.Null ||
                visual.Proxy == Entity.Null
            )
            {
                return;
            }

            if (
                !EntityManager.Exists(
                    visual.Source
                ) ||
                !EntityManager.Exists(
                    visual.Proxy
                )
            )
            {
                return;
            }

            if (
                !EntityManager.HasComponent<UnderConstruction>(
                    visual.Source
                )
            )
            {
                return;
            }

            Game.Objects.Transform sourceTransform =
                EntityManager.GetComponentData<
                    Game.Objects.Transform
                >(
                    visual.Source
                );

            UnderConstruction construction =
                EntityManager.GetComponentData<UnderConstruction>(
                    visual.Source
                );

            float progress =
                math.saturate(
                    construction.m_Progress /
                    100f
                );

            UpdateBuildingProxy(
                visual,
                sourceTransform,
                progress
            );

            UpdateScaffold(
                visual,
                sourceTransform,
                progress
            );

            LogProgress(
                visual,
                construction
            );
        }

        // ============================================================
        // BUILDING RISE
        // ============================================================

        private void UpdateBuildingProxy(
            ConstructionVisual visual,
            Game.Objects.Transform sourceTransform,
            float progress
        )
        {
            if (
                visual.Proxy == Entity.Null ||
                !EntityManager.Exists(
                    visual.Proxy
                )
            )
            {
                return;
            }

            float hiddenDistance =
                visual.BuildingHeight +
                0.5f;

            float verticalOffset =
                -hiddenDistance *
                (
                    1f -
                    progress
                );

            Game.Objects.Transform proxyTransform =
                sourceTransform;

            proxyTransform.m_Position.y +=
                verticalOffset;

            EntityManager.SetComponentData(
                visual.Proxy,
                proxyTransform
            );

            if (
                !EntityManager.HasComponent<Updated>(
                    visual.Proxy
                )
            )
            {
                EntityManager.AddComponent<Updated>(
                    visual.Proxy
                );
            }
        }

        // ============================================================
        // SCAFFOLD UPDATE
        // ============================================================

        private void UpdateScaffold(
            ConstructionVisual visual,
            Game.Objects.Transform sourceTransform,
            float progress
        )
        {
            if (
                visual.ScaffoldRoot == null
            )
            {
                return;
            }

            float3 position =
                sourceTransform.m_Position;

            visual.ScaffoldRoot
                .transform
                .position =
                new Vector3(
                    position.x,
                    position.y +
                    ScaffoldGroundOffset,
                    position.z
                );

            quaternion q =
                sourceTransform.m_Rotation;

            visual.ScaffoldRoot
                .transform
                .rotation =
                new Quaternion(
                    q.value.x,
                    q.value.y,
                    q.value.z,
                    q.value.w
                );

            // --------------------------------------------------------
            // 0 - 80%:
            // reveal complete scaffold floors one at a time.
            // --------------------------------------------------------

            if (
                progress <=
                ScaffoldRiseEnd
            )
            {
                float normalized =
                    math.saturate(
                        progress /
                        ScaffoldRiseEnd
                    );

                int visibleLevels =
                    Mathf.Clamp(
                        Mathf.CeilToInt(
                            normalized *
                            visual.ScaffoldLevelCount
                        ),
                        1,
                        visual.ScaffoldLevelCount
                    );

                for (
                    int i = 0;
                    i < visual.ScaffoldLevels.Count;
                    i++
                )
                {
                    GameObject level =
                        visual.ScaffoldLevels[i];

                    if (
                        level != null
                    )
                    {
                        level.SetActive(
                            i < visibleLevels
                        );
                    }
                }

                visual.ScaffoldRoot
                    .transform
                    .localScale =
                    Vector3.one;
            }

            // --------------------------------------------------------
            // 80 - 100%:
            // all levels visible, cage descends as a whole.
            // --------------------------------------------------------

            else
            {
                for (
                    int i = 0;
                    i < visual.ScaffoldLevels.Count;
                    i++
                )
                {
                    if (
                        visual.ScaffoldLevels[i] != null
                    )
                    {
                        visual.ScaffoldLevels[i]
                            .SetActive(
                                true
                            );
                    }
                }

                float descendProgress =
                    math.saturate(
                        (
                            progress -
                            ScaffoldRiseEnd
                        ) /
                        (
                            1f -
                            ScaffoldRiseEnd
                        )
                    );

                float descendDistance =
                    visual.ScaffoldHeight +
                    2f;

                Vector3 rootPosition =
                    visual.ScaffoldRoot
                        .transform
                        .position;

                rootPosition.y -=
                    descendDistance *
                    descendProgress;

                visual.ScaffoldRoot
                    .transform
                    .position =
                    rootPosition;
            }
        }

        // ============================================================
        // CREATE COMPLETE MULTI-LEVEL SCAFFOLD
        // ============================================================

        private void CreateScaffold(
            ConstructionVisual visual
        )
        {
            DestroyScaffold(
                visual
            );

            visual.ScaffoldRoot =
                new GameObject(
                    $"ConstructionAnimation_V1_35_Scaffold_" +
                    $"{visual.Source.Index}"
                );

            visual.ScaffoldRoot.hideFlags =
                HideFlags.DontSave;

            List<Vector2> outline =
                CreateScaffoldOutline(
                    visual.Footprint
                );

            if (
                outline.Count < 3
            )
            {
                return;
            }

            visual.ScaffoldLevelCount =
                Math.Max(
                    1,
                    Mathf.CeilToInt(
                        (
                            visual.BuildingHeight +
                            1f
                        ) /
                        ScaffoldFloorHeight
                    )
                );

            visual.ScaffoldHeight =
                visual.ScaffoldLevelCount *
                ScaffoldFloorHeight;

            visual.ScaffoldLevels =
                new List<GameObject>();

            for (
                int levelIndex = 0;
                levelIndex < visual.ScaffoldLevelCount;
                levelIndex++
            )
            {
                float bottomY =
                    levelIndex *
                    ScaffoldFloorHeight;

                float topY =
                    Mathf.Min(
                        (
                            levelIndex +
                            1
                        ) *
                        ScaffoldFloorHeight,
                        visual.ScaffoldHeight
                    );

                GameObject levelRoot =
                    new GameObject(
                        $"ScaffoldLevel_{levelIndex + 1}"
                    );

                levelRoot.hideFlags =
                    HideFlags.DontSave;

                levelRoot.transform.SetParent(
                    visual.ScaffoldRoot.transform,
                    false
                );

                visual.ScaffoldLevels.Add(
                    levelRoot
                );

                CreateScaffoldLevel(
                    outline,
                    levelRoot,
                    bottomY,
                    topY,
                    levelIndex
                );

                // First level is visible immediately.
                levelRoot.SetActive(
                    levelIndex == 0
                );
            }

            ModLog.Info(
                $"V1.35 scaffold " +
                $"{visual.Source.Index}:{visual.Source.Version}: " +
                $"outlinePoints={outline.Count}, " +
                $"levels={visual.ScaffoldLevelCount}, " +
                $"floorHeight={ScaffoldFloorHeight:0.00}m"
            );
        }

        // ============================================================
        // CREATE ONE FLOOR OF SCAFFOLD
        // ============================================================

        private void CreateScaffoldLevel(
            List<Vector2> outline,
            GameObject levelRoot,
            float bottomY,
            float topY,
            int levelIndex
        )
        {
            for (
                int edgeIndex = 0;
                edgeIndex < outline.Count;
                edgeIndex++
            )
            {
                Vector2 a =
                    outline[edgeIndex];

                Vector2 b =
                    outline[
                        (
                            edgeIndex +
                            1
                        ) %
                        outline.Count
                    ];

                Vector2 edge =
                    b -
                    a;

                float edgeLength =
                    edge.magnitude;

                if (
                    edgeLength <
                    0.25f
                )
                {
                    continue;
                }

                int bays =
                    Math.Max(
                        1,
                        Mathf.CeilToInt(
                            edgeLength /
                            ScaffoldBayWidth
                        )
                    );

                // ----------------------------------------------------
                // Vertical posts.
                //
                // Since each level owns only its own 3m post segments,
                // levels can appear independently without stretching.
                // ----------------------------------------------------

                for (
                    int bay = 0;
                    bay <= bays;
                    bay++
                )
                {
                    float t =
                        bay /
                        (float)bays;

                    Vector2 p =
                        Vector2.Lerp(
                            a,
                            b,
                            t
                        );

                    CreateBeamBetween(
                        levelRoot,
                        new Vector3(
                            p.x,
                            bottomY,
                            p.y
                        ),
                        new Vector3(
                            p.x,
                            topY,
                            p.y
                        ),
                        ScaffoldBeamThickness,
                        m_ScaffoldMetalMaterial
                    );
                }

                // ----------------------------------------------------
                // Bottom / top rails.
                // ----------------------------------------------------

                CreateBeamBetween(
                    levelRoot,
                    new Vector3(
                        a.x,
                        bottomY,
                        a.y
                    ),
                    new Vector3(
                        b.x,
                        bottomY,
                        b.y
                    ),
                    ScaffoldBeamThickness,
                    m_ScaffoldMetalMaterial
                );

                CreateBeamBetween(
                    levelRoot,
                    new Vector3(
                        a.x,
                        topY,
                        a.y
                    ),
                    new Vector3(
                        b.x,
                        topY,
                        b.y
                    ),
                    ScaffoldBeamThickness,
                    m_ScaffoldMetalMaterial
                );

                // ----------------------------------------------------
                // X braces for each bay.
                // ----------------------------------------------------

                for (
                    int bay = 0;
                    bay < bays;
                    bay++
                )
                {
                    Vector2 p0 =
                        Vector2.Lerp(
                            a,
                            b,
                            bay /
                            (float)bays
                        );

                    Vector2 p1 =
                        Vector2.Lerp(
                            a,
                            b,
                            (
                                bay +
                                1
                            ) /
                            (float)bays
                        );

                    CreateBeamBetween(
                        levelRoot,
                        new Vector3(
                            p0.x,
                            bottomY,
                            p0.y
                        ),
                        new Vector3(
                            p1.x,
                            topY,
                            p1.y
                        ),
                        ScaffoldBeamThickness *
                        0.70f,
                        m_ScaffoldMetalMaterial
                    );

                    CreateBeamBetween(
                        levelRoot,
                        new Vector3(
                            p0.x,
                            topY,
                            p0.y
                        ),
                        new Vector3(
                            p1.x,
                            bottomY,
                            p1.y
                        ),
                        ScaffoldBeamThickness *
                        0.70f,
                        m_ScaffoldMetalMaterial
                    );
                }

                // ----------------------------------------------------
                // WOODEN SCAFFOLD WALKWAY
                // AT EVERY FLOOR / LEVEL.
                // ----------------------------------------------------

                CreateDeckAlongEdge(
                    levelRoot,
                    a,
                    b,
                    topY +
                    0.06f
                );
            }
        }

        // ============================================================
        // WOODEN WALKWAY ALONG ONE EDGE
        // ============================================================

        private void CreateDeckAlongEdge(
            GameObject parent,
            Vector2 a,
            Vector2 b,
            float y
        )
        {
            Vector2 direction2D =
                b -
                a;

            float length =
                direction2D.magnitude;

            if (
                length <
                0.25f
            )
            {
                return;
            }

            direction2D.Normalize();

            Vector2 center2D =
                (
                    a +
                    b
                ) *
                0.5f;

            CreateOrientedBox(
                parent,
                new Vector3(
                    center2D.x,
                    y,
                    center2D.y
                ),
                new Vector3(
                    ScaffoldDeckDepth,
                    ScaffoldDeckThickness,
                    length
                ),
                new Vector3(
                    direction2D.x,
                    0f,
                    direction2D.y
                ),
                m_ScaffoldDeckMaterial
            );
        }

        // ============================================================
        // PRIMITIVE HELPERS
        // ============================================================

        private void CreateBeamBetween(
            GameObject parent,
            Vector3 start,
            Vector3 end,
            float thickness,
            Material material
        )
        {
            Vector3 direction =
                end -
                start;

            float length =
                direction.magnitude;

            if (
                length <
                0.001f
            )
            {
                return;
            }

            GameObject beam =
                GameObject.CreatePrimitive(
                    PrimitiveType.Cube
                );

            beam.name =
                "ScaffoldBeam";

            beam.hideFlags =
                HideFlags.DontSave;

            beam.transform.SetParent(
                parent.transform,
                false
            );

            beam.transform.localPosition =
                (
                    start +
                    end
                ) *
                0.5f;

            beam.transform.localRotation =
                Quaternion.FromToRotation(
                    Vector3.forward,
                    direction.normalized
                );

            beam.transform.localScale =
                new Vector3(
                    thickness,
                    thickness,
                    length
                );

            MeshRenderer renderer =
                beam.GetComponent<MeshRenderer>();

            if (
                renderer != null &&
                material != null
            )
            {
                renderer.sharedMaterial =
                    material;
            }

            RemovePrimitiveCollider(
                beam
            );
        }

        private void CreateOrientedBox(
            GameObject parent,
            Vector3 center,
            Vector3 size,
            Vector3 forward,
            Material material
        )
        {
            GameObject box =
                GameObject.CreatePrimitive(
                    PrimitiveType.Cube
                );

            box.name =
                "ScaffoldWoodDeck";

            box.hideFlags =
                HideFlags.DontSave;

            box.transform.SetParent(
                parent.transform,
                false
            );

            box.transform.localPosition =
                center;

            if (
                forward.sqrMagnitude >
                0.001f
            )
            {
                box.transform.localRotation =
                    Quaternion.FromToRotation(
                        Vector3.forward,
                        forward.normalized
                    );
            }
            else
            {
                box.transform.localRotation =
                    Quaternion.identity;
            }

            box.transform.localScale =
                size;

            MeshRenderer renderer =
                box.GetComponent<MeshRenderer>();

            if (
                renderer != null &&
                material != null
            )
            {
                renderer.sharedMaterial =
                    material;
            }

            RemovePrimitiveCollider(
                box
            );
        }

        private static void RemovePrimitiveCollider(
            GameObject gameObject
        )
        {
            if (
                gameObject == null
            )
            {
                return;
            }

            try
            {
                Component component =
                    gameObject.GetComponent(
                        "BoxCollider"
                    );

                if (
                    component != null
                )
                {
                    UnityEngine.Object.Destroy(
                        component
                    );
                }
            }
            catch
            {
            }
        }

        // ============================================================
        // MATERIALS
        // ============================================================

        private void CreateScaffoldMaterials()
        {
            DestroyScaffoldMaterials();

            Shader shader =
                Shader.Find(
                    "HDRP/Lit"
                );

            if (
                shader == null
            )
            {
                shader =
                    Shader.Find(
                        "Standard"
                    );
            }

            if (
                shader == null
            )
            {
                ModLog.Info(
                    "V1.35 WARNING: no scaffold shader found."
                );

                return;
            }

            // --------------------------------------------------------
            // METAL
            // --------------------------------------------------------

            m_ScaffoldMetalMaterial =
                new Material(
                    shader
                );

            m_ScaffoldMetalMaterial.name =
                "ConstructionAnimation_ScaffoldMetal";

            UnityEngine.Color metal =
                new UnityEngine.Color(
                    0.09f,
                    0.085f,
                    0.07f,
                    1f
                );

            SetMaterialColor(
                m_ScaffoldMetalMaterial,
                metal
            );

            if (
                m_ScaffoldMetalMaterial.HasProperty(
                    "_Metallic"
                )
            )
            {
                m_ScaffoldMetalMaterial.SetFloat(
                    "_Metallic",
                    0.70f
                );
            }

            if (
                m_ScaffoldMetalMaterial.HasProperty(
                    "_Smoothness"
                )
            )
            {
                m_ScaffoldMetalMaterial.SetFloat(
                    "_Smoothness",
                    0.25f
                );
            }

            // --------------------------------------------------------
            // WOOD
            // --------------------------------------------------------

            m_ScaffoldDeckMaterial =
                new Material(
                    shader
                );

            m_ScaffoldDeckMaterial.name =
                "ConstructionAnimation_ScaffoldWood";

            UnityEngine.Color wood =
                new UnityEngine.Color(
                    0.38f,
                    0.25f,
                    0.11f,
                    1f
                );

            SetMaterialColor(
                m_ScaffoldDeckMaterial,
                wood
            );

            if (
                m_ScaffoldDeckMaterial.HasProperty(
                    "_Metallic"
                )
            )
            {
                m_ScaffoldDeckMaterial.SetFloat(
                    "_Metallic",
                    0f
                );
            }

            if (
                m_ScaffoldDeckMaterial.HasProperty(
                    "_Smoothness"
                )
            )
            {
                m_ScaffoldDeckMaterial.SetFloat(
                    "_Smoothness",
                    0.08f
                );
            }
        }

        private static void SetMaterialColor(
            Material material,
            UnityEngine.Color color
        )
        {
            if (
                material == null
            )
            {
                return;
            }

            if (
                material.HasProperty(
                    "_BaseColor"
                )
            )
            {
                material.SetColor(
                    "_BaseColor",
                    color
                );
            }

            if (
                material.HasProperty(
                    "_Color"
                )
            )
            {
                material.SetColor(
                    "_Color",
                    color
                );
            }

            try
            {
                material.color =
                    color;
            }
            catch
            {
            }
        }

        private void DestroyScaffoldMaterials()
        {
            if (
                m_ScaffoldMetalMaterial != null
            )
            {
                try
                {
                    UnityEngine.Object.Destroy(
                        m_ScaffoldMetalMaterial
                    );
                }
                catch
                {
                }

                m_ScaffoldMetalMaterial =
                    null;
            }

            if (
                m_ScaffoldDeckMaterial != null
            )
            {
                try
                {
                    UnityEngine.Object.Destroy(
                        m_ScaffoldDeckMaterial
                    );
                }
                catch
                {
                }

                m_ScaffoldDeckMaterial =
                    null;
            }
        }

        // ============================================================
        // ECS VISUAL COPY
        // ============================================================

        private void CopyVisualComponent<T>(
            Entity source,
            Entity target
        )
            where T : unmanaged,
            IComponentData
        {
            if (
                !EntityManager.HasComponent<T>(
                    source
                )
            )
            {
                return;
            }

            T value =
                EntityManager.GetComponentData<T>(
                    source
                );

            if (
                EntityManager.HasComponent<T>(
                    target
                )
            )
            {
                EntityManager.SetComponentData(
                    target,
                    value
                );
            }
            else
            {
                EntityManager.AddComponentData(
                    target,
                    value
                );
            }
        }

        private void CopyMeshColorBuffer(
            Entity source,
            Entity targetEntity
        )
        {
            if (
                !EntityManager.HasBuffer<MeshColor>(
                    targetEntity
                )
            )
            {
                EntityManager.AddBuffer<MeshColor>(
                    targetEntity
                );
            }

            DynamicBuffer<MeshColor> target =
                EntityManager.GetBuffer<MeshColor>(
                    targetEntity
                );

            target.Clear();

            if (
                !EntityManager.HasBuffer<MeshColor>(
                    source
                )
            )
            {
                return;
            }

            DynamicBuffer<MeshColor> sourceBuffer =
                EntityManager.GetBuffer<MeshColor>(
                    source
                );

            for (
                int i = 0;
                i < sourceBuffer.Length;
                i++
            )
            {
                target.Add(
                    sourceBuffer[i]
                );
            }
        }

        private void CopyCustomMeshColorBuffer(
            Entity source,
            Entity targetEntity
        )
        {
            if (
                !EntityManager.HasBuffer<CustomMeshColor>(
                    targetEntity
                )
            )
            {
                EntityManager.AddBuffer<CustomMeshColor>(
                    targetEntity
                );
            }

            DynamicBuffer<CustomMeshColor> target =
                EntityManager.GetBuffer<CustomMeshColor>(
                    targetEntity
                );

            target.Clear();

            if (
                !EntityManager.HasBuffer<CustomMeshColor>(
                    source
                )
            )
            {
                return;
            }

            DynamicBuffer<CustomMeshColor> sourceBuffer =
                EntityManager.GetBuffer<CustomMeshColor>(
                    source
                );

            for (
                int i = 0;
                i < sourceBuffer.Length;
                i++
            )
            {
                target.Add(
                    sourceBuffer[i]
                );
            }
        }

        // ============================================================
        // DESTROY ONE CONSTRUCTION
        // ============================================================

        private void DestroyConstructionVisual(
            ConstructionVisual visual
        )
        {
            if (
                visual == null
            )
            {
                return;
            }

            DestroyScaffold(
                visual
            );

            ScheduleNativeProxyDestroy(
                visual.Proxy
            );

            visual.Proxy =
                Entity.Null;

            visual.Source =
                Entity.Null;
        }

        private void DestroyScaffold(
            ConstructionVisual visual
        )
        {
            if (
                visual == null
            )
            {
                return;
            }

            if (
                visual.ScaffoldRoot != null
            )
            {
                try
                {
                    UnityEngine.Object.Destroy(
                        visual.ScaffoldRoot
                    );
                }
                catch
                {
                }
            }

            visual.ScaffoldRoot =
                null;

            visual.ScaffoldLevels.Clear();

            visual.ScaffoldHeight =
                0f;

            visual.ScaffoldLevelCount =
                0;
        }

        // ============================================================
        // PROXY CLEANUP
        // ============================================================

        private void ScheduleNativeProxyDestroy(
            Entity proxy
        )
        {
            if (
                proxy == Entity.Null ||
                !EntityManager.Exists(proxy)
            )
            {
                return;
            }

            try
            {
                if (
                    !EntityManager.HasComponent<Deleted>(
                        proxy
                    )
                )
                {
                    EntityManager.AddComponent<Deleted>(
                        proxy
                    );
                }

                if (
                    !EntityManager.HasComponent<Updated>(
                        proxy
                    )
                )
                {
                    EntityManager.AddComponent<Updated>(
                        proxy
                    );
                }

                m_PendingProxyDestroys.Add(
                    new PendingProxyDestroy
                    {
                        Entity = proxy,
                        Frames = 0
                    }
                );
            }
            catch
            {
                try
                {
                    if (
                        EntityManager.Exists(proxy)
                    )
                    {
                        EntityManager.DestroyEntity(
                            proxy
                        );
                    }
                }
                catch
                {
                }
            }
        }

        private void ProcessPendingProxyDestroys()
        {
            for (
                int i =
                    m_PendingProxyDestroys.Count - 1;
                i >= 0;
                i--
            )
            {
                PendingProxyDestroy pending =
                    m_PendingProxyDestroys[i];

                Entity proxy =
                    pending.Entity;

                if (
                    proxy == Entity.Null ||
                    !EntityManager.Exists(proxy)
                )
                {
                    m_PendingProxyDestroys.RemoveAt(
                        i
                    );

                    continue;
                }

                pending.Frames++;

                try
                {
                    if (
                        !EntityManager.HasComponent<Deleted>(
                            proxy
                        )
                    )
                    {
                        EntityManager.AddComponent<Deleted>(
                            proxy
                        );
                    }

                    if (
                        !EntityManager.HasComponent<Updated>(
                            proxy
                        )
                    )
                    {
                        EntityManager.AddComponent<Updated>(
                            proxy
                        );
                    }
                }
                catch
                {
                }

                if (
                    pending.Frames <
                    ProxyDestroyDelayFrames
                )
                {
                    continue;
                }

                try
                {
                    if (
                        EntityManager.Exists(proxy)
                    )
                    {
                        EntityManager.DestroyEntity(
                            proxy
                        );
                    }
                }
                catch
                {
                }

                m_PendingProxyDestroys.RemoveAt(
                    i
                );
            }
        }

        // ============================================================
        // LOGGING
        // ============================================================

        private void LogProgress(
            ConstructionVisual visual,
            UnderConstruction construction
        )
        {
            if (
                visual.LastProgress ==
                construction.m_Progress
            )
            {
                return;
            }

            byte progress =
                construction.m_Progress;

            if (
                progress == 0 ||
                progress == 10 ||
                progress == 25 ||
                progress == 50 ||
                progress == 75 ||
                progress == 80 ||
                progress == 90 ||
                progress >= 98
            )
            {
                ModLog.Info(
                    $"V1.35 source=" +
                    $"{visual.Source.Index}:" +
                    $"{visual.Source.Version} " +
                    $"progress={progress}%"
                );
            }

            visual.LastProgress =
                progress;
        }

        // ============================================================
        // DESTROY
        // ============================================================

        protected override void OnDestroy()
        {
            foreach (
                ConstructionVisual visual
                in m_Visuals.Values
            )
            {
                DestroyScaffold(
                    visual
                );

                if (
                    visual.Proxy != Entity.Null
                )
                {
                    try
                    {
                        if (
                            EntityManager.Exists(
                                visual.Proxy
                            )
                        )
                        {
                            EntityManager.DestroyEntity(
                                visual.Proxy
                            );
                        }
                    }
                    catch
                    {
                    }
                }
            }

            m_Visuals.Clear();

            for (
                int i = 0;
                i < m_PendingProxyDestroys.Count;
                i++
            )
            {
                Entity proxy =
                    m_PendingProxyDestroys[i]
                        .Entity;

                try
                {
                    if (
                        proxy != Entity.Null &&
                        EntityManager.Exists(
                            proxy
                        )
                    )
                    {
                        EntityManager.DestroyEntity(
                            proxy
                        );
                    }
                }
                catch
                {
                }
            }

            m_PendingProxyDestroys.Clear();

            DestroyScaffoldMaterials();

            base.OnDestroy();
        }
    }
}